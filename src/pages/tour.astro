---
import Base from '../layouts/Base.astro';
const chapters = [
  ['0 · Ground you already stand on', 'print, let / let mut, fn, primitives, if-as-expression, match, loops, f-strings. Move fast — it\'s familiar.'],
  ['1 · The locus', 'types vs loci, your first locus, the lifecycle (birth → run → drain → dissolve), self and state, the namespace-lotus pattern.'],
  ['2 · Composition & lifetime', 'parent owns child (accept), self.children, contracts, the region memory model, the six-pattern catalog.'],
  ['3 · Failure, two channels', 'no exceptions, fallible(E) + fail, the or surface, closure tests, violate, on_failure + restart / quarantine / bubble.'],
  ['4 · Concurrency, the bus & the seam', 'cooperative scheduling, topics, the <- send, placement, and the deployment seam — split one binary into a fleet by editing only main.'],
  ['5 · Data & interfaces', 'structural interfaces, forms (@form vec / hashmap / ring_buffer), Bytes vs BytesBuilder, the collection idioms.'],
  ['6 · Capstone: monolith → fleet', 'build a small realtime pipeline, run it as one binary, then make it distributed without touching your logic.'],
];
---
<Base title="The Hale tour">
  <section class="container prose">
    <span class="tag">/tour</span>
    <h1>The tour</h1>
    <p class="lede">
      The fastest way to learn Hale: one concept per lesson, runnable in the
      browser, building from <code>hello</code> to a distributed system. The
      interactive version is coming with the playground — here's the curriculum.
    </p>
    <div class="grid" style="margin-top:1.5rem;">
      {chapters.map(([h, p]) => (
        <div class="feature">
          <h4 style="font-family:var(--mono);font-size:0.95rem;">{h}</h4>
          <p>{p}</p>
        </div>
      ))}
    </div>
  </section>
</Base>
