---
import Base from '../layouts/Base.astro';
import Hale from '../components/Hale.astro';
import Logo from '../components/Logo.astro';
import DeploymentSwitcher from '../components/DeploymentSwitcher.astro';
import Unfold from '../components/Unfold.astro';
import GrowthSwitcher from '../components/GrowthSwitcher.astro';
import '../styles/storefront.css';
// Written by scripts/sync-docs.mjs from the compiler checkout's Cargo.toml,
// alongside the sidebar — so the version on the homepage cannot drift from
// the workspace the docs were synced out of. Run the sync if this is missing.
import release from '../generated/release.json';

/*
  The hero sample. Ordinary on purpose — argument, file, print — and
  real API: `arg_or` and `read_file … or <default>` are the documented
  everyday shapes, and check-site compiles this like every other panel.
*/
const notes = `fn main() {
    let path = std::env::arg_or(1, "notes.txt");
    let body = std::io::fs::read_file(path) or "(no notes yet)";
    println(body);
}`;

const room = `type Msg { room: String; user: String; text: String; }

topic Posted    { payload: Msg; keyed_by room; }
topic Broadcast { payload: Msg; }

locus Room {
    params { name: String = "lobby"; }

    bus {
        subscribe Posted as on_post where key == self.name;
        publish Broadcast;
    }

    fn on_post(m: Msg) {
        Broadcast <- m;
    }
}`;

/*
  Offstage context (scripts/check-site.mjs prepends `<name>_prelude` before
  `hale check`; nothing renders it). The panel shows the declaration whose
  dependency set is the point; the topics it names have to exist somewhere
  for that to mean anything.
*/
const dependency_prelude = `type Summary { id: Int; }
type Config  { limit: Int; }

topic PublicSummary { payload: Summary; }
topic ConfigChanged { payload: Config; }

locus Relay {
    bus { publish PublicSummary; publish ConfigChanged; }
    fn emit(s: Summary) { PublicSummary <- s; }
}
`;
const dependency = `@effects(depends: {PublicSummary, ConfigChanged})
locus Report {
    bus {
        subscribe PublicSummary as on_summary;
        subscribe ConfigChanged as configure;
    }

    fn on_summary(s: Summary) { }
    fn configure(c: Config) { }
}`;

const dependencyDiagnostic = `declared dependency set violated:
  Report can transitively depend on PrivateFeed

Path:
  subject PrivateFeed
  -> Relay
  -> subject PublicSummary
  -> Report`;

const failure = `locus WorkerPool {
    accept(c: Worker) { }

    on_failure(c: Worker, err: ClosureViolation) {
        restart(c);
    }
}`;
---
<Base>
  <section class="container wide hero storefront-hero">
    <div class="split">
      <div class="text-pool">
        <div class="hero-lockup" aria-hidden="true">
          <Logo class="lockup-mark" />
          <span class="lockup-divider"></span>
          <span class="lockup-wordmark">hale</span>
        </div>
        {/* The category, stated flatly — the repositioning brief's whole
            diagnosis was that the site answered "what makes Hale unusual?"
            before "what is it?", and read as a distributed-systems DSL.
            The eyebrow names the category; the h1 carries the promise; the
            systems thesis ("Write the system, not the lore.") now lands
            mid-page, after ordinary code has earned it. */}
        <p class="eyebrow">general-purpose · native · memory-safe</p>
        <h1><span>Start with a program.</span><span>Keep the language when it becomes a system.</span></h1>
        <p class="lede">
          Hale is a general-purpose language for scripts, services, and
          systems. Write ordinary functions, CLIs, files, JSON, HTTP, and
          WebAssembly. As the program grows, the same language makes
          ownership, concurrency, placement, effects, and architectural
          rules visible to the compiler.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/playground">Run Hale</a>
          <a class="btn btn-ghost" href="/docs">Read the guide</a>
        </div>
        <div class="install">
          <span class="sigil">$</span>
          <span class="cmd">curl -fsSL https://hale-lang.org/install.sh | sh</span>
        </div>
        {/* "Shipped" and "stable" are different promises, and a visitor who
            cannot tell them apart will discover the difference the expensive
            way. Saying pre-1.0 out loud costs nothing and buys the rest of
            the page some credit. */}
        <p class="release-status">
          <b>v{release.minor}{release.prerelease ? ' · prerelease' : ''}</b> —
          Linux, macOS, and WebAssembly. Language and artifact schemas remain
          subject to change.
        </p>
      </div>
      <div class="hero-code">
        {/* Ordinary on purpose: the first code a visitor sees must not
            require the locus model to recognize Hale as a programming
            language. The systems showpiece (room.hl) moved to the
            why-Hale section below. */}
        <Hale code={notes} title="notes.hl" />
        <p class="hero-code-note">
          A complete Hale program. <code>hale build</code> makes it one
          static binary; nothing here declares a lifecycle, a topic, or a
          placement.
        </p>
      </div>
    </div>
  </section>

  <section class="container wide build-section">
    <div class="section-intro">
      <p class="eyebrow">general-purpose, checked</p>
      <h2>What can I build with it?</h2>
    </div>
    <div class="build-cards">
      <a href="/docs/everyday/cli-config">
        <strong>CLI tools</strong>
        <span>Arguments, environment, files, and layered config from the
        standard library. <code>hale build</code> gives you one static
        binary.</span>
      </a>
      <a href="/docs/everyday/http">
        <strong>Web apps &amp; APIs</strong>
        <span><code>std::http</code> ships the server, router, and JSON
        codecs; a handler is an ordinary locus. No framework decision
        before the first route.</span>
      </a>
      <a href="/docs/services/lifecycle">
        <strong>Concurrent services</strong>
        <span>Typed topics instead of channels and locks; supervision
        instead of shutdown choreography; the compiler checks who talks
        to whom.</span>
      </a>
      <a href="/docs/systems/memory">
        <strong>Low-level systems</strong>
        <span>Memory layout, placement, zero-copy I/O, and C bindings —
        visible when you ask for them, absent from the code that
        doesn't.</span>
      </a>
      <a href="/docs/systems/webassembly">
        <strong>WebAssembly</strong>
        <span>The same program compiles to <code>wasm32</code> with a
        small JS loader. The typed bus runs in the browser exactly as it
        does natively.</span>
      </a>
    </div>
    <div class="section-link"><a href="/examples">Everyday programs, with their evidence →</a></div>
  </section>

  <section class="section-alt">
    <div class="container wide">
      <div class="section-intro">
        <p class="eyebrow">the same program, three altitudes</p>
        <h2>It grows without switching languages.</h2>
        <p class="lede">
          The tutorial's job queue, at three sizes. Watch what each tab
          adds — and what it leaves alone.
        </p>
      </div>
      <GrowthSwitcher />
      <div class="section-link"><a href="/docs/tutorial/job-queue">Build this yourself in thirty minutes →</a></div>
    </div>
  </section>

  <section class="container wide altitude-section">
    <div class="section-intro">
      <p class="eyebrow">one language, four altitudes</p>
      <h2>Use only as much language as the program needs.</h2>
    </div>
    <ol class="ladder">
      <li>
        <span class="rung-scale">script</span>
        <code>fn main()</code>
        <p>Data, functions, control flow. A complete program with nothing else in it.</p>
      </li>
      <li>
        <span class="rung-scale">everyday</span>
        <code>locus · std::*</code>
        <p>Files, JSON, HTTP, tests. The altitude you'd reach for Python or Node.</p>
      </li>
      <li>
        <span class="rung-scale">service</span>
        <code>topic · bus</code>
        <p>Long-running loci, typed messages, supervision. Where you'd reach for Go.</p>
      </li>
      <li>
        <span class="rung-scale">systems</span>
        <code>placement · bindings · claims</code>
        <p>Layout, placement, transports, architectural law. Where you'd reach for Rust or C++.</p>
      </li>
    </ol>
    <p class="ladder-note">
      This is control altitude, not system scale — how much machinery you
      choose to see, not how large the system is (the model page keeps the
      two axes apart). Each level only reveals more of the same locus: the
      function you wrote at the top keeps compiling, unchanged, at the
      bottom.
    </p>
  </section>

  <section class="container wide why-hale">
    <div class="split">
      <div class="text-pool">
        <p class="eyebrow">why hale</p>
        <h2>Write the system, not the lore.</h2>
        <p>
          Your codebase eventually becomes more than code: who owns which
          state, what talks to what, where things run, what a change is
          allowed to break. In most languages those facts live in review
          comments, diagrams, and deployment lore — true until someone
          forgets. Hale gives them a place in the program, where the
          compiler can hold them.
        </p>
        <p>
          The chat room on the right is the everyday version of that
          bargain: each phrase you would say out loud — a room, each
          posted message, relay it to everyone — has a line of code to
          live in.
        </p>
        <div class="section-link"><a href="/model">Read the model →</a></div>
      </div>
      <div>
        <Hale code={room} title="room.hl" />
        <div class="sentence-map" aria-label="How the description maps to Hale">
          <span><b>a room</b><code>locus Room</code></span>
          <span><b>each posted message</b><code>subscribe Posted</code></span>
          <span><b>in that room</b><code>keyed_by room</code></span>
          <span><b>relay it to everyone</b><code>publish Broadcast</code></span>
        </div>
      </div>
    </div>
  </section>

  <section class="why-now">
    <div class="container wide why-now-inner">
      <p class="eyebrow">why now</p>
      <h2>Code is getting cheaper. Consequences are not.</h2>
      <p>
        More implementations will be produced by more people and more tools.
        The scarce part is knowing what each part may touch, publish, block on,
        allocate, depend on, or destroy. Hale makes those facts part of the
        program instead of leaving them in review comments and deployment lore.
      </p>
    </div>
  </section>

  <Unfold />

  {/*
    A "one ladder, six rungs" section once stood here walking system
    SCALE (value/component/service/application/environment/fleet) — cut
    because Unfold's beats walk the same scales. The ladder that returned
    above the fold is a different axis: control ALTITUDE (script/everyday/
    service/systems), which Unfold does not cover — the model page's "two
    axes, not one ladder" section is the authority on the distinction.
  */}

  <section class="section-alt">
    <div class="container wide">
      <div class="section-intro">
        <p class="eyebrow">one typed edge, several mechanisms</p>
        <h2>Build a monolith. Deploy a distributed system.</h2>
        <p class="lede">
          The loci and their topic sends stay put. Change <code>main</code> to
          decide where they run and how each edge travels.
        </p>
      </div>

      <DeploymentSwitcher />

      <p class="deployment-contract">
        A successful send means the broker accepted the message under the
        selected binding's guarantee. A binding that cannot be opened fails the
        declaring locus at birth; it does not leave a route that claims success
        while dropping everything.
      </p>
      <div class="section-link"><a href="/docs/services/multi-binary">Across binaries →</a></div>
    </div>
  </section>

  <section class="section-alt causal-section" id="causality">
    <div class="container wide">
      <div class="section-intro">
        <p class="eyebrow">causality as a contract</p>
        <h2>The compiler follows the system past the function call.</h2>
        <p class="lede">
          A call graph stops at a publish. Hale continues through the typed bus
          graph, across republishers and into the loci that receive the result.
        </p>
      </div>

      <div class="causal-proof">
        <div>
          <Hale code={dependency} title="report.hl" />
          <p>
            The declaration says exactly which subjects may transitively
            influence <code>Report</code>. It is a complete set, not a comment.
          </p>
        </div>
        <div>
          <Hale code={dependencyDiagnostic} title="hale check" />
          <p>
            A violation names the architectural path, including the innocent-
            looking republished subject that hid the original dependency.
          </p>
        </div>
      </div>

      <div class="proof-list proof-list-wide">
        <article><b>Operational effects</b><p>Block, syscall, time, entropy, FFI, publish, spawn, recursion, and allocation.</p></article>
        <article><b>Causal reach</b><p>What a function may cause through calls and topic publication.</p></article>
        <article><b>Dependency sets</b><p>What may transitively influence a locus through its subscriptions.</p></article>
        <article><b>Budgets</b><p>Hard bounds such as zero allocations per call on a hot path.</p></article>
      </div>
      <div class="section-link"><a href="/proof">Everything the compiler certifies →</a></div>
    </div>
  </section>

  <section class="container wide">
    <div class="band">
      <div class="split">
        <div>
          <p class="eyebrow" style="color:var(--jade-deep);">the toolchain</p>
        {/* This was "One binary, the whole loop." over a list of the
            subcommands — which is /tooling's own headline and opening
            sentence, near enough word for word. A teaser that previews the
            page it links to gives a reader nothing to click for, so this
            states the consequence instead and leaves the inventory there. */}
          <h2>The checker is fast enough to be a keystroke.</h2>
          {/* "about ten milliseconds" with no corpus, machine, or statistic
              behind it reads as a latency guarantee we never measured in the
              shape a reader will test it. The claim that matters is the
              consequence, and it survives a slower machine. */}
          <p>
            <code>hale check</code> runs a whole-project check fast enough for
            interactive editor feedback, so the same structured diagnostic
            reaches an editor, a CI job, and a coding assistant — and the one
            that fails your build is the one you already read while typing.
          </p>
          <div class="hero-actions" style="margin-bottom:0;">
            <a class="btn btn-primary" href="/tooling">Tooling</a>
            <a class="btn btn-ghost" href="/docs">Read the guide</a>
          </div>
        </div>
        <Hale code={failure} title="supervision.hl" />
      </div>
    </div>
  </section>

  <section class="section-alt credibility">
    <div class="container wide">
      <div>
        <p class="eyebrow">built to be inspected</p>
        <h2>Claims should have somewhere to land.</h2>
      </div>
      <div class="credibility-links">
        <a href="/proof"><strong>Verification</strong><span>Every check the compiler runs, with the witness it returns.</span></a>
        <a href="/examples"><strong>Examples</strong><span>System shapes that cross ownership, messaging, and deployment.</span></a>
        <a href="/articles"><strong>Articles</strong><span>Technical changes written in context.</span></a>
        <a href="https://github.com/hale-lang"><strong>Source</strong><span>Compiler, runtime, libraries, and site.</span></a>
      </div>
    </div>
  </section>

  <section class="container center final-cta">
    <div class="text-pool">
    <p class="eyebrow">the shortest useful introduction</p>
    <h2>Run a system, then change its deployment.</h2>
    <p class="lede" style="margin-inline:auto;">
      The playground tour starts with ordinary code and ends with typed
      communication, ownership, supervision, and placement.
    </p>
    <div class="hero-actions" style="justify-content:center;">
      <a class="btn btn-primary" href="/playground">Open the playground</a>
      <a class="btn btn-ghost" href="/model">Read the model</a>
    </div>
    </div>
  </section>
</Base>
