<script>
  // Copy the install line; fall back to selecting it where the clipboard
  // is refused.
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => {
    b.addEventListener('click', () => {
      const text = b.dataset.copy ?? '';
      navigator.clipboard?.writeText(text).then(
        () => { b.textContent = 'copied'; setTimeout(() => (b.textContent = 'copy'), 1600); },
        () => {
          const cmd = b.parentElement?.querySelector('.cmd');
          if (!cmd) return;
          const r = document.createRange();
          r.selectNodeContents(cmd);
          const s = getSelection();
          s?.removeAllRanges();
          s?.addRange(r);
        },
      );
    });
  });

  // The chat room: hovering a phrase lights the line it lives on.
  document.querySelectorAll<HTMLElement>('.smap li[data-line]').forEach((li) => {
    const line = document.getElementById(li.dataset.line ?? '');
    if (!line) return;
    li.addEventListener('mouseenter', () => line.classList.add('hl'));
    li.addEventListener('mouseleave', () => line.classList.remove('hl'));
  });
</script>
