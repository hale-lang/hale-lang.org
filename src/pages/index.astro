---
import Base from '../layouts/Base.astro';
import Hale from '../components/Hale.astro';
import Terminal from '../components/Terminal.astro';
import LotusField from '../components/LotusField.astro';
import GrowthSwitcher from '../components/GrowthSwitcher.astro';
import Unfold from '../components/Unfold.astro';
import DeploymentSwitcher from '../components/DeploymentSwitcher.astro';
import ReleaseList from '../components/ReleaseList.astro';
import { session } from '../data/dna-session.mjs';
// The README's performance table, read at build time (scripts/sync-docs.mjs).
import perf from '../generated/performance.json';
// Written by scripts/sync-docs.mjs from the compiler checkout's Cargo.toml,
// so the version on the homepage cannot drift from the docs it ships with.
import release from '../generated/release.json';

/*
  The opening program. Ordinary on purpose (an argument, a file, a print)
  and real API: `arg_or` and `read_file … or <default>` are the documented
  everyday shapes, and check-site compiles this like every other panel.
*/
const notes = `fn main() {
    let path = std::env::arg_or(1, "notes.txt");
    let body = std::io::fs::read_file(path) or "(no notes yet)";
    println(body);
}`;

/* The chat room: each phrase of its description has a line to live on. */
const room = `type Msg { room: String; user: String; text: String; }

topic Posted    { payload: Msg; keyed_by room; }
topic Broadcast { payload: Msg; }

locus Room {
    params { name: String = "lobby"; }

    bus {
        subscribe Posted as on_post where key == self.name;
        publish Broadcast;
    }

    fn on_post(m: Msg) {
        Broadcast <- m;
    }
}`;
const roomMarks = { ids: { 3: 'r-keyed', 6: 'r-locus', 10: 'r-sub', 11: 'r-pub' } };

/*
  Offstage context (scripts/check-site.mjs prepends `<name>_prelude` before
  `hale check`; nothing renders it). The panel shows the declaration whose
  dependency set is the point; the topics it names have to exist somewhere
  for that to mean anything.
*/
const dependency_prelude = `type Summary { id: Int; }
type Config  { limit: Int; }

topic PublicSummary { payload: Summary; }
topic ConfigChanged { payload: Config; }

locus Relay {
    bus { publish PublicSummary; publish ConfigChanged; }
    fn emit(s: Summary) { PublicSummary <- s; }
}
`;
const dependency = `@effects(depends: {PublicSummary, ConfigChanged})
locus Report {
    bus {
        subscribe PublicSummary as on_summary;
        subscribe ConfigChanged as configure;
    }

    fn on_summary(s: Summary) { }
    fn configure(c: Config) { }
}`;

const dependencyDiagnostic = `declared dependency set violated:
  Report can transitively depend on PrivateFeed

Path:
  subject PrivateFeed
  -> Relay
  -> subject PublicSummary
  -> Report`;
const diagnosticMarks = { warn: [1, 7] };

const perfDate = new Date(perf.date + 'T00:00:00Z').toLocaleDateString('en-GB', { timeZone: 'UTC', day: 'numeric', month: 'short', year: 'numeric' });

const failure = `locus WorkerPool {
    accept(c: Worker) { }

    on_failure(c: Worker, err: ClosureViolation) {
        restart(c);
    }
}`;
---
<Base>
  <section class="wrap hero" aria-labelledby="claim">
    <LotusField />
    <div class="text">
      <h1 id="claim">Less language. More compiler.</h1>
      <p class="lede hero-sub">One language from a five-line script to a distributed system.</p>
      <div class="install" role="group" aria-label="Install Hale">
        <span class="sigil" aria-hidden="true">$</span>
        <span class="cmd" id="install-cmd">curl -fsSL https://hale-lang.org/install.sh | sh</span>
        <button class="copy" type="button" data-copy="curl -fsSL https://hale-lang.org/install.sh | sh" aria-label="Copy the install command">copy</button>
      </div>
      <div class="actions">
        <a class="btn btn-primary" href="/playground">Try it in the browser</a>
        <a class="btn btn-ghost" href="/docs">Read the guide</a>
      </div>
      {/* "Shipped" and "stable" are different promises; saying pre-1.0 out
          loud costs nothing and buys the rest of the page some credit. */}
      <p class="release">
        <b>v{release.minor}{release.prerelease ? ' · prerelease' : ''}</b>. Prebuilt for Linux x86-64, Linux ARM64 and
        Apple Silicon. Compiles to native binaries and to wasm32. Syntax and
        artifact formats still change between releases. Apache-2.0, built on
        LLVM 18.
      </p>
    </div>
    <div class="hero-code">
      <Hale code={notes} title="notes.hl" kind="everyday" foot={['hale build · one static binary', 'hale check · ok']} />
      <p class="listing-note">
        A complete program. <code>hale build</code> makes it one static
        binary. It declares no lifecycle, topic or placement, and will not
        need to until it has a second part.
      </p>
    </div>
  </section>

  <section class="wrap gets-sec" aria-labelledby="gets-h">
    <h2 id="gets-h" class="sr-only">What Hale does for you</h2>
    <ul class="gets">
      <li><b>Architecture checked every build</b><span>Write a rule such as “billing never calls research”. Any code that breaks it fails the build, and the error shows the path.</span></li>
      <li><b>Concurrency without locks or races</b><span>Parts of a program talk by sending typed messages, so there is no shared memory to lock.</span></li>
      <li><b>Same code, one box or a fleet</b><span>Run a part on its own thread, process or machine by editing one block. The part itself stays as written.</span></li>
      <li><b>No garbage collector</b><span>Memory is freed when the part that owns it stops. No pauses, and no lifetimes to annotate.</span></li>
      <li><b>Money and time with units</b><span>Cents, dollars and milliseconds are types. Mixing them up, or rounding without saying how, is a compile error.</span></li>
      <li><b>Every failure has an owner</b><span>A crash goes to the part that started it, which can restart it, isolate it or pass it up.</span></li>
      <li><b>APIs without server code</b><span>List the functions to expose and who may call each. Hale serves them over HTTP, a socket or MCP. Arrives in the next release.</span></li>
      <li><b>Script to service, one language</b><span>Start with a five-line script. Add messaging, deployment and rules later, in the same file and the same tools.</span></li>
      <li><b>Delivery, ops and governance built in</b><span>Hale DNA wraps your app in review, deploys, rollbacks and an audit log kept in git. People and AI work under rules you set.</span></li>
      <li><b>Shared infrastructure across apps</b><span>Several apps and teams share records, access and identity, each kept separate. Designed, and partly built.</span></li>
    </ul>
    <div class="sec-link"><a href="/glossary">Hale's own words, in familiar terms →</a></div>
  </section>

  <section class="wrap sec" aria-labelledby="build-h">
    <div class="sec-head">
      <h2 id="build-h">What you can write with it today</h2>
    </div>
    <ul class="rows">
      <li><a href="/docs/everyday/cli-config">
        <strong>CLI tools</strong>
        <span>Arguments, environment, files and layered config come from the
        standard library. <code>hale build</code> produces one static
        binary.</span>
        <span class="surface">hale build</span>
      </a></li>
      <li><a href="/docs/everyday/http">
        <strong>HTTP servers and clients</strong>
        <span><code>std::http</code> has the server, the router, the client
        and JSON codecs. A handler is an ordinary locus, so there is no
        framework to pick first.</span>
        <span class="surface">std::http</span>
      </a></li>
      <li><a href="/docs/services/lifecycle">
        <strong>Services with many parts</strong>
        <span>Parts talk over typed topics. A parent owns its children and
        decides what happens when one fails. The compiler checks who
        publishes and who subscribes.</span>
        <span class="surface">topic · bus</span>
      </a></li>
      <li><a href="/docs/systems/memory">
        <strong>Low-level code</strong>
        <span>Memory layout, placement on threads and cores, zero-copy I/O
        and C bindings are available when a program asks for them and
        absent from one that doesn't.</span>
        <span class="surface">placement · bindings</span>
      </a></li>
      <li><a href="/docs/systems/webassembly">
        <strong>WebAssembly</strong>
        <span>The same program compiles to <code>wasm32</code> with a small
        JS loader. The playground runs the result in the browser.</span>
        <span class="surface">wasm32</span>
      </a></li>
    </ul>
    <div class="sec-link"><a href="/examples">Example programs, and what the compiler checked about each →</a></div>
  </section>

  <section class="wrap sec" aria-labelledby="alt-h">
    <div class="frame">
      <span class="frame-meta">docs/tutorial/job-queue</span>
      <div class="sec-head">
        <h2 id="alt-h">A script, then a service, then a deployment.</h2>
        <p class="lede">
          The job queue from the tutorial at three sizes. Each step adds a
          block. The earlier blocks are not edited.
        </p>
      </div>
      <GrowthSwitcher />
      <div class="sec-link"><a href="/docs/tutorial/job-queue">The tutorial builds this in about thirty minutes →</a></div>
    </div>
  </section>

  <section class="wrap sec" aria-labelledby="ladder-h">
    <div class="sec-head">
      <h2 id="ladder-h">How much of the language a program uses</h2>
    </div>
    <ol class="ladder">
      <li><span class="rung">script</span><code>fn main()</code><p>Data, functions and control flow. A complete program with nothing else in it.</p></li>
      <li><span class="rung">everyday</span><code>locus · std::*</code><p>Files, JSON, HTTP and tests. The level you would use Python or Node for.</p></li>
      <li><span class="rung">service</span><code>topic · bus</code><p>Long-running loci, typed messages and supervision. The level you would use Go for.</p></li>
      <li><span class="rung">systems</span><code>placement · bindings · claims</code><p>Layout, placement, transports and claims over the whole graph. The level you would use Rust or C++ for.</p></li>
    </ol>
    <p class="ladder-note">
      This is how much of the machinery you choose to see. How large the
      system is, its scale, is a separate axis, and the model page keeps the
      two apart. Each level shows more of the same locus, and a function
      written at the top compiles unchanged at the bottom. The guide has two
      more parts that go outward: the organization that changes a program,
      and what several programs and their people share.
    </p>
  </section>

  <section class="wrap sec" aria-labelledby="why-h">
    <div class="split">
      <div class="text">
        <h2 id="why-h">A chat room, in Hale.</h2>
        <p style="margin-top:var(--s4)">
          Say the service out loud. A chat room takes each message posted to
          it and relays it to everyone in the room. The code you then write
          in most languages looks nothing like that sentence. There is a
          connection registry, a member list with a lock around it, a
          broadcast loop and some async plumbing, and by the time it works
          the idea is buried.
        </p>
        <p>
          Each phrase has one place to live in Hale, in the order you said
          it. The bus is the routing table, so with ten rooms a posted
          message costs one delivery, and the handler never filters.
        </p>
        <div class="sec-link"><a href="/model">How the ownership model works →</a></div>
      </div>
      <div>
        <Hale code={room} title="room.hl" kind="service" marks={roomMarks} />
        <ul class="smap" aria-label="Each phrase of the description and the line it lives on">
          <li data-line="r-locus"><b>a chat room</b><code>locus Room</code></li>
          <li data-line="r-sub"><b>each message posted to it</b><code>subscribe Posted</code></li>
          <li data-line="r-keyed"><b>in the room</b><code>keyed_by room</code></li>
          <li data-line="r-pub"><b>relays it to everyone</b><code>publish Broadcast</code></li>
        </ul>
      </div>
    </div>
  </section>

  <hr class="rule" />

  <section class="wrap quote" aria-labelledby="why-now-h">
    <h2 id="why-now-h">Why a new language in 2026</h2>
    <p>
      Code is written faster than it is read, and more of it is written by
      models. The two rules that review used to enforce by hand, one owner
      for every piece of state and no reaching sideways, are the only shape
      this language accepts, so the enforcement moved out of review and into
      the build. The checker reads for shape and rules. A person reads for
      whether it is the right shape for the problem.
    </p>
    <div class="sec-link"><a href="/articles/what-the-hale">Why build a new language in 2026 →</a></div>
  </section>

  <hr class="rule" />

  <section class="wrap sec" aria-labelledby="stairs-h">
    <div class="sec-head">
      <h2 id="stairs-h">The same construct, from a function to a fleet</h2>
      <p class="lede">
        Hale folds classes, modules, actors and services into one construct,
        a component that owns its state and talks only through declared
        messages. It is called a locus, and every box below is one. A value's
        unit, a function's effects, a component's memory, an application's
        rules and a deployment's routes are the same idea at different sizes,
        which is why one checker can follow all of them.
      </p>
    </div>
    <Unfold />
    <div class="thesis">
      <div>
        <h3>An abstract systems language</h3>
        <p>
          A systems language lets you declare memory and layout, and checks
          them. Hale also lets you declare the parts of a system: who owns
          which state, what talks to what, where each part runs, what a
          function may do, what a number counts. The compiler checks those
          too. Units, effects, claims and targets are all declarations it
          holds you to.
        </p>
      </div>
      <div>
        <h3>Is this Erlang's OTP with types?</h3>
        <p>
          The resemblance is real: components that own their state, messages
          between them, and supervisors that decide what happens when one
          fails. OTP finds its process graph at run time. Hale's compiler
          knows the whole graph before the program runs, so a message on an
          undeclared topic, a payload that does not match, or a broken rule
          about who may reach what fails the build. A Hale program compiles to
          a native binary with no virtual machine and no garbage collector,
          and a message between two parts on one thread can compile to a
          direct call. Where each part runs, on a pool, a pinned core or
          another process, is one block in <code>main</code>.
        </p>
      </div>
    </div>
  </section>

  <section class="wrap sec" aria-labelledby="deploy-h" id="deploy">
    <div class="sec-head">
      <h2 id="deploy-h">Placement and bindings</h2>
      <p class="lede">
        Five <code>main</code> blocks deploy the same two loci, Ingest and
        Rollup. Only where they run and how <code>Samples</code> travels
        changes.
      </p>
    </div>
    <DeploymentSwitcher />
    <p class="contract">
      A send succeeds when the broker has accepted the message under the
      binding's guarantee. A binding that cannot be opened fails the
      declaring locus at birth, so no route is left that reports success
      while dropping messages.
    </p>
    <div class="sec-link"><a href="/docs/services/multi-binary">Programs split across binaries →</a></div>
  </section>

  <section class="wrap sec" aria-labelledby="causal-h" id="causality">
    <div class="sec-head">
      <h2 id="causal-h">What the compiler sees past a publish.</h2>
      <p class="lede">
        A call graph ends at a publish. Hale continues through the bus,
        through loci that republish, and into the loci that receive the
        result.
      </p>
    </div>
    <div class="proof">
      <div>
        <Hale code={dependency} title="report.hl" kind="systems" />
        <p>
          The declaration lists every subject that may transitively influence <code>Report</code>.
          The list is complete, so anything not on it is an error.
        </p>
      </div>
      <div>
        <Hale code={dependencyDiagnostic} title="hale check" kind="dependency witness" lang="text" marks={diagnosticMarks} />
        <p>
          The violation names the path, including the republished subject
          that carried the hidden dependency.
        </p>
      </div>
    </div>
    <div class="grid4" role="list" aria-label="What the compiler checks">
      <article role="listitem"><b>Effects</b><p>syscall, block, time, entropy, env, ffi, publish, spawn, recursion and alloc, proven over the whole call graph.</p></article>
      <article role="listitem"><b>Causal reach</b><p>What a function may cause through calls and publishes.</p></article>
      <article role="listitem"><b>Dependency sets</b><p>What may influence a locus through its subscriptions.</p></article>
      <article role="listitem"><b>Budgets</b><p>Numeric bounds, such as zero allocations per call.</p></article>
    </div>
    <div class="sec-link"><a href="/proof">Every check, with the witness it returns →</a></div>
  </section>

  <section class="wrap sec" aria-labelledby="tool-h">
    <div class="band-box">
      <div class="split">
        <div class="text">
          <h2 id="tool-h">One binary: build, run, check, verify, test, bench, fmt, doc, fetch and fleet.</h2>
          <p style="margin-top:var(--s4)">
            <code>hale check</code> runs a whole-project check quickly enough
            to run as you type. The language server and the MCP server are
            compiled into the same binary, so an editor, a CI job and a
            coding assistant read the same diagnostic.
          </p>
          <div class="actions">
            <a class="btn btn-primary" href="/tooling">The toolchain</a>
            <a class="btn btn-ghost" href="/docs">Read the guide</a>
          </div>
        </div>
        <Hale code={failure} title="supervision.hl" kind="service" />
      </div>
    </div>
  </section>

  <section class="wrap sec" aria-labelledby="limits-h" id="limits">
    <div class="sec-head">
      <h2 id="limits-h">What it rejects, what it misses, and where it is slower</h2>
      <p class="lede">
        The short version, for a reader who already writes Rust, Zig or Go.
        The proof page shows each check with the witness it returns.
      </p>
    </div>
    <div class="checks">
      <div>
        <h3>The build fails on</h3>
        <ul class="facts">
          <li><b>An undeclared topic</b><p>A publish or subscribe that names a topic nothing declares.</p></li>
          <li><b>A payload mismatch</b><p>A publisher and a subscriber that disagree on a topic's type.</p></li>
          <li><b>An unhandled failure</b><p>A call that can fail with no <code>or</code> saying what happens.</p></li>
          <li><b>A broken effect or budget</b><p>A function that reaches an effect it ruled out, or allocates past its budget, with the path that does it.</p></li>
          <li><b>A broken claim</b><p>A path the rules forbid, such as billing reaching research, returned as a counterexample.</p></li>
          <li><b>A silent rounding</b><p>A narrowing to a coarser unit with no rounding policy.</p></li>
        </ul>
      </div>
      <div>
        <h3>It does not check</h3>
        <ul class="facts">
          <li><b>What a handler computes</b><p><code>+1</code> and <code>+100</code> have the same structure. Correctness of the arithmetic is your tests' job.</p></li>
          <li><b>Time</b><p>Budgets count allocations, stack depth, blocking points, publishes and fan-out. None of them bounds latency.</p></li>
          <li><b>Information flow</b><p>A sealed component keeps its key, and a value derived from that key is not tracked.</p></li>
          <li><b>Calls it cannot resolve</b><p>A call through a function value is reported as unknown, a third answer beside yes and no, and a hard contract fails closed on it.</p></li>
          <li><b>The runtime's own code</b><p>Models of its synchronization protocols are checked, and their match to the shipped C is maintained by hand.</p></li>
        </ul>
      </div>
    </div>
    <div class="sec-link"><a href="/proof">Every check, with the witness it returns →</a></div>
    <div class="perf">
      <h3>Against Go</h3>
      <p class="muted">
        Hale {perf.version} on {perfDate}, {perf.machine}, the same workload
        shape in each language. Faster at message dispatch, JSON parsing and
        collections; slower at plain function calls and at creating
        components.
      </p>
      <div class="tbl-wrap">
        <table class="tbl">
          <thead><tr><th scope="col">benchmark</th><th scope="col">Hale</th><th scope="col">Go</th><th scope="col">Hale is</th></tr></thead>
          <tbody>
            {perf.rows.map((r) => (
              <tr>
                <td><code>{r.bench.split(' ')[0]}</code> <span class="muted">{r.bench.split(' ').slice(1).join(' ')}</span></td>
                <td class="num">{r.hale}</td>
                <td class="num">{r.go}</td>
                <td class:list={['num', /slower/.test(r.verdict) ? 'slower' : 'faster']}>{r.verdict}{r.footnote ? ' *' : ''}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="muted" style="font-size:.9rem;margin-top:var(--s3)">
        * LLVM vectorizes that reduction and Go's compiler does not, so it
        measures vectorization of reducible loops, and says little about loop
        speed in general.
      </p>
      <p style="margin-top:var(--s4)">
        Every component owns a memory region, so calls and spawns pay region
        setup that message dispatch and collections amortize away. A cheaper
        call protocol and spawn path are on the roadmap.
      </p>
      <div class="sec-link"><a href={perf.grid}>The full grid, with C and Rust, and how to reproduce it →</a></div>
    </div>
  </section>

  <section class="wrap sec" aria-labelledby="dna-h" id="dna">
    <div class="frame">
      <span class="frame-meta">hale dna init . &amp;&amp; hale dna dev</span>
      <div class="sec-head">
        <h2 id="dna-h">One program for building, running, governing and recording an application.</h2>
        <p class="lede">
          <code>hale dna init</code> generates it next to your code and leaves
          the application untouched: people with final say, called the Board;
          a model-backed reviewer that decides within limits they set, called
          the Leader; the models and the budget it may use; and the parts that make each change in a sandbox, prove it
          with the toolchain, show it to whoever holds the authority, apply
          exactly what was approved, restart or redeploy it, and watch it. Its
          working state lives in memory it owns. Its history is a branch of
          your repository, <code>refs/dna/journal</code>, one commit per event.
        </p>
      </div>
      <Terminal code={session} kind="the demo application, editor on scripted models" />
      <div class="grid4" role="list" aria-label="What one review shows">
        <article role="listitem"><b>Source diff</b><p>The candidate commit against the baseline, as git shows it.</p></article>
        <article role="listitem"><b>Structural diff</b><p><code>hale model diff</code>: what changed in the program's shape. Who talks to whom, which effects are reached, whether a rule went from holding to violated.</p></article>
        <article role="listitem"><b>Evidence</b><p>check, verify, test, the fleet it would deploy and a rehearsed rollback, each kept under its own hash and pinned to the commit.</p></article>
        <article role="listitem"><b>Verdict</b><p>The Leader decides inside the grant, with its reasoning and cost on the record. The Board decides outside it, or when the law, an effect or the fleet's shape moves, and the Board is people.</p></article>
      </div>
      <h3 style="margin:var(--s12) 0 var(--s4)">What it needs, and what it does not claim</h3>
      <ul class="nots">
        <li><b>git</b><p>The record lives in the repository. Alone on one machine no remote is needed. A team, or nodes, need one.</p></li>
        <li><b>docker compose</b><p><code>hale dna dev</code> brings up its private services with it: Postgres for its working state, NATS for messaging between its parts, Prometheus for monitoring.</p></li>
        <li><b>A model</b><p>A key in the vault, ollama on your PATH, or a coding harness on it. DNA still runs without one; the Leader cannot decide anything, and every review waits for you.</p></li>
        <li><b>Every change waits</b><p>Each waits for a verdict, the Leader's inside its grant or the Board's. A restart is a restart. Live state does not carry across.</p></li>
        <li><b>A blind spot</b><p>The structural view cannot see what a handler computes. A <code>+1</code> becoming <code>+100</code> is invisible to it, so the source diff is never optional, for people or for the Leader.</p></li>
        <li><b>Shared infrastructure</b><p>Several applications and teams sharing records, access and identity. Designed and partly built; <a href="/dna#habitat">the DNA page</a> says which pieces are in the tree.</p></li>
      </ul>
      <div class="sec-link"><a href="/docs/dna">DNA in the guide →</a> &nbsp;·&nbsp; <a href="/dna">DNA on one page →</a></div>
    </div>
  </section>

  <section class="wrap sec" aria-labelledby="nots-h">
    <div class="sec-head">
      <h2 id="nots-h">What it is not.</h2>
    </div>
    <ul class="nots">
      <li><b>1.0</b><p>Version {release.minor} is a prerelease. Syntax and artifact formats change between releases.</p></li>
      <li><b>A substitute for design</b><p>One owner and declared channels give software its form. The substance, where the seams go, is still the whole job, and a locus-shaped program can still have every seam in the wrong place.</p></li>
      <li><b>A reason to split everything</b><p>A script is one locus. Add a second when there is a real seam, and not before.</p></li>
    </ul>
  </section>

  <section class="wrap sec" aria-labelledby="open-h">
    <div class="sec-head">
      <h2 id="open-h">Built in the open</h2>
