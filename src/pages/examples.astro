---
import Base from '../layouts/Base.astro';
import Field from '../components/Field.astro';
import ExampleRow from '../components/ExampleRow.astro';
import { examples } from '../examples/manifest.mjs';
import captures from '../generated/examples.json';

/*
  Every row is a pair: the program, and what the compiler says about it.
  The outputs come from src/generated/examples.json, produced at build time
  by scripts/capture-examples.mjs invoking the compiler, so nothing here is
  transcribed by hand and nothing can quietly rot. Everyday programs come
  first: a visitor should see the programs they would write in Python or
  Node before the systems the language was named for.
*/
const cap = (id: string) => (captures.examples as any)[id] ?? {};
const fullMods = import.meta.glob('../examples/full/*.mjs', { eager: true });
const fulls = Object.values(fullMods)
  .map((m: any) => m.full)
  .map((f: any) => ({ ...f, lines: (captures as any).fulls?.[f.slug]?.lines ?? 0 }));

const everyday = examples.filter((e) => e.tier === 'everyday');
const systems = examples.filter((e) => e.tier !== 'everyday');
---
<Base
  title="Examples"
  description="Hale programs beside what the compiler says about them: everyday CLIs, JSON, files and HTTP, then systems with keyed topics, causal boundaries, certified hot paths and claims, each with a deliberate break."
>
  <Field />
  <section class="wrap page">
    <div class="page-head">
      <h1>Programs, and what the compiler says about them</h1>
      <p class="lede">
        Each program sits beside a deliberate break. The run output and the
        compiler's refusal are captured from <code>{captures.hale.split('\n')[0]}</code> at build time, so nothing under a machine label is
        typed by hand.
      </p>
    </div>

    <div class="prose wide">
      <h2 style="margin-top:0">Everyday Hale</h2>
      <p class="muted">Arguments, files, JSON, HTTP and config. The level you would use Python or Node for.</p>
    </div>
    {everyday.map((ex) => <ExampleRow ex={ex} cap={cap(ex.id)} />)}

    <div class="prose wide" style="margin-top:var(--s12)">
      <h2 style="margin-top:0">Complete programs</h2>
      <p class="muted">Whole programs, read top to bottom. The code on each page concatenates to the exact program the build verified.</p>
    </div>
    <div class="cards">
      {fulls.map((f: any) => (
        <a href={`/examples/${f.slug}`}>
          <span class="cardfile">{f.lines ? `${f.lines} lines · ` : ''}{f.file ?? (f.files ?? []).join(', ')}</span>
          <strong>{f.title}</strong>
          <span>{f.tagline}</span>
        </a>
      ))}
    </div>

    <div class="prose wide" style="margin-top:var(--s12)">
      <h2 style="margin-top:0">One guarantee at a time</h2>
      <p class="muted">The same discipline at snippet scale: the honest version and a one-line break, with the compiler's refusal beside it.</p>
    </div>
    {systems.map((ex) => <ExampleRow ex={ex} cap={cap(ex.id)} />)}

    <div class="prose" style="margin-top:var(--s12)">
      <h2 style="margin-top:0">The whole progression</h2>
      <p>The browser tour moves from ordinary functions to loci, typed topics, supervision and deployment without changing tools.</p>
      <div class="actions"><a class="btn btn-primary" href="/playground">Open the playground</a></div>
    </div>
  </section>
</Base>
