---
import Base from '../layouts/Base.astro';
import Field from '../components/Field.astro';
import Hale from '../components/Hale.astro';
import { examples } from '../examples/manifest.mjs';
import captures from '../generated/examples.json';
import '../styles/storefront.css';

/*
  Every panel is a pair: the program, and what the machine says
  about it. The outputs come from src/generated/examples.json,
  produced at build time by scripts/capture-examples.mjs invoking
  the compiler — nothing here is transcribed by hand, so nothing
  here can quietly rot. The "break it" tab is the page's argument:
  the diagnostic, not the declaration, is the product.
*/
const cap = (id) => (captures.examples as any)[id] ?? {};
const fullMods = import.meta.glob('../examples/full/*.mjs', {
  eager: true,
});
const fulls = Object.values(fullMods)
  .map((m: any) => m.full)
  .map((f: any) => ({
    ...f,
    lines: (captures as any).fulls?.[f.slug]?.lines ?? 0,
  }));
---
<Base
  title="Hale examples"
  description="Hale programs beside what the compiler says about them: run output, refusals with witnesses, and a recorded run replayed."
>
  <Field kind="examples" />
  <section class="container wide examples-page">
    <div class="section-intro">
      <p class="eyebrow">examples</p>
      <h1>Complete systems, with their evidence.</h1>
      <p class="lede">
        Full programs read top to bottom, beside what the machine says
        about them — run transcripts, refusals with witnesses, recorded
        runs replayed. Everything is captured from
        <code>{captures.hale}</code> at build time; the code on every
        page concatenates to the exact program the build verified.
      </p>
    </div>

    <div class="full-cards">
      {fulls.map((f) => (
        <a class="full-card" href={`/examples/${f.slug}`}>
          <p class="eyebrow">{f.lines} lines · {f.file}</p>
          <h2>{f.title}</h2>
          <p>{f.tagline}</p>
          <span class="card-cta">Read the whole system →</span>
        </a>
      ))}
    </div>

    <div class="section-intro strip-intro">
      <h2 class="strip-title">One guarantee at a time.</h2>
      <p class="lede">
        The same discipline at snippet scale: the honest version and a
        one-line break, with the compiler's actual refusal beside it.
      </p>
    </div>

    {examples.map((ex, i) => {
      const c = cap(ex.id);
      return (
        <div class={`example-row ${i % 2 ? 'rev' : ''}`}>
          <div class="example-prose">
            <p class="eyebrow">{ex.eyebrow}</p>
            <h2>{ex.title}</h2>
            <p>{ex.prose}</p>
            <a href={ex.docs.href}>{ex.docs.label} →</a>
          </div>
          <div class="example-panel">
            <input
              type="radio"
              name={`tab-${ex.id}`}
              id={`tab-${ex.id}-ok`}
              checked
            />
            <input
              type="radio"
              name={`tab-${ex.id}`}
              id={`tab-${ex.id}-brk`}
            />
            <div class="panel-tabs">
              <label for={`tab-${ex.id}-ok`}>program</label>
              {(ex.brk || ex.session) && (
                <label for={`tab-${ex.id}-brk`}>
                  {ex.session ? 'record & replay' : 'break it'}
                </label>
              )}
            </div>
            <div class="pane pane-ok">
              <Hale code={ex.program} title={ex.file} />
              {c.run && (
                <pre class="machine machine-run"><span class="machine-label">$ hale run {ex.file}</span>{'\n'}{c.run.output}</pre>
              )}
            </div>
            <div class="pane pane-brk">
              {ex.brk && (
                <>
                  <pre class="diff"><span class="diff-note">{ex.brk.note}</span>{'\n'}{ex.brk.find.split('\n').map((l) => `- ${l}`).join('\n')}{'\n'}{ex.brk.replace.split('\n').filter((l) => !ex.brk.find.includes(l)).map((l) => `+ ${l}`).join('\n')}</pre>
                  {c.brk && (
                    <pre class="machine machine-err"><span class="machine-label">$ hale check {ex.file}</span>{'\n'}{c.brk.output}</pre>
                  )}
                </>
              )}
              {ex.session && c.session && (
                <pre class="machine machine-run"><span class="machine-label">$ {ex.session.steps.join('\n$ ')}</span>{'\n'}{c.session.output}{c.session.source === 'pinned' ? `\n\n# ${c.session.label}` : ''}</pre>
              )}
            </div>
          </div>
        </div>
      );
    })}

    <div class="examples-next">
      <h2>Try the full progression.</h2>
      <p>
        The browser tour moves from ordinary functions to loci, typed
        topics, supervision, and deployment without changing tools.
      </p>
      <a class="btn btn-primary" href="/playground">Open the playground</a>
    </div>
  </section>
</Base>

<style>
  .full-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
    gap: 1rem;
    margin: 2rem 0 3.5rem;
  }
  .full-card {
    display: block;
    padding: 1.3rem 1.4rem;
    border: 1px solid color-mix(in srgb, currentColor 18%, transparent);
    border-radius: 12px;
    text-decoration: none;
  }
  .full-card:hover {
    border-color: currentColor;
  }
  .full-card h2 {
    margin: 0.35rem 0 0.5rem;
    font-size: 1.25rem;
  }
  .full-card p {
    margin: 0;
    font-size: 0.92rem;
    opacity: 0.8;
  }
  .full-card .eyebrow {
    opacity: 0.6;
  }
  .card-cta {
    display: inline-block;
    margin-top: 0.9rem;
    font-weight: 600;
    font-size: 0.9rem;
  }
  .strip-intro {
    margin-top: 1rem;
  }
  .strip-title {
    font-size: 1.5rem;
  }
  .example-panel {
    min-width: 0;
  }
  .example-panel > input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .panel-tabs {
    display: flex;
    gap: 0.25rem;
    margin-bottom: 0.5rem;
  }
  .panel-tabs label {
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    cursor: pointer;
    opacity: 0.55;
    border: 1px solid color-mix(in srgb, currentColor 25%, transparent);
  }
  .pane {
    display: none;
  }
  .example-panel
    > input:first-of-type:checked
    ~ .pane-ok {
    display: block;
  }
  .example-panel
    > input:nth-of-type(2):checked
    ~ .pane-brk {
    display: block;
  }
  .example-panel
    > input:first-of-type:checked
    ~ .panel-tabs
    label:first-child,
  .example-panel
    > input:nth-of-type(2):checked
    ~ .panel-tabs
    label:last-child {
    opacity: 1;
    border-color: currentColor;
  }
  .machine,
  .diff {
    margin: 0.5rem 0 0;
    padding: 0.7rem 0.9rem;
    border-radius: 8px;
    font-size: 0.8rem;
    line-height: 1.55;
    overflow-x: auto;
    white-space: pre;
  }
  .machine {
    background: color-mix(in srgb, currentColor 6%, transparent);
  }
  .machine-label {
    opacity: 0.55;
  }
  .machine-err {
    border-left: 3px solid #d4564e;
  }
  .machine-run {
    border-left: 3px solid #4a9d6b;
  }
  .diff {
    background: color-mix(in srgb, currentColor 5%, transparent);
  }
  .diff-note {
    opacity: 0.6;
    font-style: italic;
  }
</style>
