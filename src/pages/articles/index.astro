---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const all = await getCollection('articles');
const posts = all.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
---

<Base title="Articles">
  <section class="container prose">
    <span class="tag">/articles</span>
    <h1>Articles &amp; announcements</h1>
    <p class="lede">
      Releases written as prose rather than a list of commits, and technical
      pieces about one thing at a time. Everything here is dated and stays
      put — a note from a year ago describes the language as it was then.
    </p>

    <ul class="article-list">
      {posts.map((p) => (
        <li>
          <div class="meta">
            <span class={`kind kind-${p.data.kind}`}>
              {p.data.kind === 'announcement' ? 'Announcement' : 'Article'}
            </span>
            <time datetime={p.data.date.toISOString()}>
              {fmt(p.data.date)}
            </time>
            {p.data.version && <span class="ver">{p.data.version}</span>}
          </div>
          <a class="title" href={`/articles/${p.id}`}>{p.data.title}</a>
          <p class="summary">{p.data.summary}</p>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .article-list {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
  }
  .article-list li {
    padding: 1.25rem 0;
    border-top: 1px solid var(--border, #2a2a2a);
  }
  .meta {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    font-size: 0.85rem;
    opacity: 0.75;
    margin-bottom: 0.35rem;
    flex-wrap: wrap;
  }
  .kind {
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.72rem;
    padding: 0.1rem 0.45rem;
    border-radius: 3px;
    border: 1px solid currentColor;
  }
  .ver {
    font-family: var(--font-mono, monospace);
  }
  a.title {
    display: block;
    font-size: 1.25rem;
    font-weight: 600;
    text-decoration: none;
    margin-bottom: 0.3rem;
  }
  a.title:hover {
    text-decoration: underline;
  }
  .summary {
    margin: 0;
    opacity: 0.85;
  }
</style>
