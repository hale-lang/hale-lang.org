---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Field from '../../components/Field.astro';

const all = await getCollection('articles');

/*
  Two views of one collection, per the go.dev/blog model: the index
  is a dense, flat, newest-first table a reader scans in one screen —
  not a feed of cards. The series survives as a single-line strip of
  its parts in READING order (a series is one argument; its order is
  not its publication order), so it costs one row instead of a
  section per part.
*/
const names = [
  ...new Set(
    all
      .filter((p) => p.data.series)
      .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf())
      .map((p) => p.data.series as string),
  ),
];
const series = names.map((name) => ({
  name,
  posts: all
    .filter((p) => p.data.series === name)
    .sort((a, b) => (a.data.part ?? 0) - (b.data.part ?? 0)),
}));

const index = [...all].sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', {
    // Frontmatter dates coerce to UTC midnight, so formatting in the
    // build machine's local zone renders every article a day early
    // anywhere west of UTC.
    timeZone: 'UTC',
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  });

const tag = (p: (typeof all)[number]) =>
  p.data.series && p.data.part
    ? `${p.data.series} · ${p.data.part}`
    : p.data.kind === 'announcement'
      ? 'announcement'
      : null;
---

<Base title="Articles">
  <Field kind="articles" />
  <section class="container prose articles-index">
    <span class="tag">/articles</span>
    <h1>Articles &amp; announcements</h1>

    {series.map((s) => (
      <p class="series-strip">
        <span class="series-name">{s.name}</span>
        {s.posts.map((p, i) => (
          <>
            {i > 0 && <span class="series-sep" aria-hidden="true">·</span>}
            <a href={`/articles/${p.id}`}
              ><span class="series-part">{p.data.part}</span> {p.data.title}</a
            >
          </>
        ))}
      </p>
    ))}

    <ol class="index" reversed>
      {index.map((p) => (
        <li>
          <span class="date">{fmt(p.data.date)}</span>
          <span class="entry">
            <span class="head">
              <a href={`/articles/${p.id}`}>{p.data.title}</a>
              {tag(p) && <span class="entry-tag">{tag(p)}</span>}
            </span>
            <span class="summary">{p.data.summary}</span>
          </span>
        </li>
      ))}
    </ol>
  </section>
</Base>

<style>
  .series-strip {
    margin: 1.5rem 0 0;
    font-size: 0.9rem;
    line-height: 1.9;
  }
  .series-name {
    font-weight: 650;
    margin-right: 0.6rem;
  }
  .series-name::after {
    content: ':';
  }
  .series-sep {
    opacity: 0.4;
    margin: 0 0.35rem;
  }
  .series-strip a {
    text-decoration: none;
    white-space: nowrap;
  }
  .series-strip a:hover {
    text-decoration: underline;
  }
  .series-part {
    opacity: 0.55;
    font-variant-numeric: tabular-nums;
  }

  .index {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
  }
  .index li {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 0 1rem;
    padding: 0.45rem 0;
    border-top: 1px solid
      color-mix(in srgb, currentColor 12%, transparent);
  }
  .index li:first-child {
    border-top: none;
  }
  .date {
    font-size: 0.82rem;
    opacity: 0.6;
    font-variant-numeric: tabular-nums;
    padding-top: 0.15rem;
    white-space: nowrap;
  }
  .entry {
    min-width: 0;
  }
  .head {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    min-width: 0;
  }
  .head a {
    font-weight: 600;
    text-decoration: none;
  }
  .head a:hover {
    text-decoration: underline;
  }
  .entry-tag {
    font-size: 0.75rem;
    opacity: 0.55;
    white-space: nowrap;
  }
  .summary {
    display: block;
    font-size: 0.88rem;
    opacity: 0.75;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 40rem) {
    .index li {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .summary {
      white-space: normal;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
    }
  }
</style>
