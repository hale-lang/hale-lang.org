---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const all = await getCollection('articles');

// A series is one argument in several parts, so it is listed in
// READING order under its own heading; standalone pieces stay
// newest-first below. Series are ordered by when each one started.
const names = [
  ...new Set(
    all
      .filter((p) => p.data.series)
      .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf())
      .map((p) => p.data.series as string),
  ),
];
const series = names.map((name) => ({
  name,
  posts: all
    .filter((p) => p.data.series === name)
    .sort((a, b) => (a.data.part ?? 0) - (b.data.part ?? 0)),
}));
const loose = all
  .filter((p) => !p.data.series)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', {
    // Frontmatter dates coerce to UTC midnight, so formatting in the
    // build machine's local zone renders every article a day early
    // anywhere west of UTC.
    timeZone: 'UTC',
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });

// One line of plain text under the title. The pieces are
// self-describing — a date is a date, a kind is a kind — so they are
// joined rather than each given a badge.
const meta = (p: (typeof all)[number]) =>
  [
    p.data.part ? `Part ${p.data.part}` : null,
    p.data.kind === 'announcement' ? 'Announcement' : 'Technical article',
    fmt(p.data.date),
    p.data.version ?? null,
  ]
    .filter(Boolean)
    .join(' · ');
---

<Base title="Articles">
  <section class="container prose">
    <span class="tag">/articles</span>
    <h1>Articles &amp; announcements</h1>

    {series.map((s) => (
      <section class="block">
        <h2>{s.name}</h2>
        <ul class="list">
          {s.posts.map((p) => (
            <li>
              <a href={`/articles/${p.id}`}>{p.data.title}</a>
              <p class="meta">{meta(p)}</p>
              <p class="summary">{p.data.summary}</p>
            </li>
          ))}
        </ul>
      </section>
    ))}

    {loose.length > 0 && (
      <section class="block">
        {series.length > 0 && <h2>Everything else</h2>}
        <ul class="list">
          {loose.map((p) => (
            <li>
              <a href={`/articles/${p.id}`}>{p.data.title}</a>
              <p class="meta">{meta(p)}</p>
              <p class="summary">{p.data.summary}</p>
            </li>
          ))}
        </ul>
      </section>
    )}
  </section>
</Base>

<style>
  .block {
    margin-top: 2.5rem;
  }
  .list {
    list-style: none;
    padding: 0;
    margin: 1.25rem 0 0;
  }
  .list li + li {
    margin-top: 1.75rem;
  }
  .list a {
    font-size: 1.15rem;
    font-weight: 600;
    text-decoration: none;
  }
  .list a:hover {
    text-decoration: underline;
  }
  .meta {
    font-size: 0.85rem;
    opacity: 0.7;
    margin: 0.2rem 0 0.4rem;
  }
  .summary {
    margin: 0;
    opacity: 0.85;
  }
</style>
