---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Field from '../../components/Field.astro';

const all = await getCollection('articles');

/*
  One view, per the go.dev/blog model: a dense, flat, newest-first list a
  reader scans in one screen. Each entry says who wrote it, from the
  `authorship` field the collection requires, so a reader never has to
  guess whether a piece was written by a person or a model.
*/
const index = [...all].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmt = (d: Date) =>
  // Frontmatter dates coerce to UTC midnight; format in UTC or every
  // article reads a day early west of Greenwich.
  d.toLocaleDateString('en-GB', { timeZone: 'UTC', day: 'numeric', month: 'short', year: 'numeric' });

const series = (p: (typeof all)[number]) =>
  p.data.series && p.data.part ? `${p.data.series} · ${p.data.part}` : null;
---
<Base title="Articles" description="Changes to the language, written in context, with who wrote each one.">
  <Field />
  <section class="wrap page">
    <div class="page-head">
      <h1>Articles and announcements</h1>
      <p class="lede">
        Changes to the language, written in context. Each entry says who
        wrote it: the frontmatter records whether an article was written by
        a person or by a model, and the list shows it.
      </p>
    </div>
    <ol class="index" reversed>
      {index.map((p) => (
        <li>
          <span class="date">{fmt(p.data.date)}</span>
          <span class="entry">
            <span class="head">
              <a href={`/articles/${p.id}`}>{p.data.title}</a>
              {series(p) && <span class="tag">{series(p)}</span>}
              {p.data.authorship === 'human'
                ? <span class="tag">written by hand</span>
                : <span class="tag ai">written by a model</span>}
            </span>
            <span class="summary">{p.data.summary}</span>
          </span>
        </li>
      ))}
    </ol>
  </section>
</Base>
