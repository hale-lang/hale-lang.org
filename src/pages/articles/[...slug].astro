---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArticleNav from '../../components/ArticleNav.astro';
import Field from '../../components/Field.astro';

export async function getStaticPaths() {
  const posts = await getCollection('articles');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Next chapter, for readers who came in from a search result rather
// than the sidebar, since the end of a piece is where "what now?" happens.
const all = await getCollection('articles');
const siblings = post.data.series
  ? all
      .filter((p) => p.data.series === post.data.series)
      .sort((a, b) => (a.data.part ?? 0) - (b.data.part ?? 0))
  : [];
const here = siblings.findIndex((p) => p.id === post.id);
const prev = here > 0 ? siblings[here - 1] : undefined;
const next =
  here >= 0 && here < siblings.length - 1 ? siblings[here + 1] : undefined;

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', {
    // Frontmatter dates coerce to UTC midnight, so formatting in the
    // build machine's local zone renders every article a day early
    // anywhere west of UTC.
    timeZone: 'UTC',
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
---

<Base title={post.data.title} description={post.data.summary}>
  <Field />
  <div class="wrap page article-wrap">
    <aside class="side">
      <ArticleNav current={post.id} />
    </aside>

    <article class="prose article-body">
      <div class="article-meta">
        <span class="kind">
          {post.data.kind === 'announcement'
            ? 'Announcement'
            : post.data.kind === 'post'
              ? 'Essay'
              : 'Technical article'}
        </span>
        <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
        {post.data.updated && (
          <time datetime={post.data.updated.toISOString()}>updated {fmt(post.data.updated)}</time>
        )}
        {post.data.version && <span>{post.data.version}</span>}
        <span>{post.data.authorship === 'human' ? 'written by hand' : 'written by a model'}</span>
      </div>
      {post.data.series && (
        <p class="series">{post.data.series} · part {post.data.part} of {siblings.length}</p>
      )}
      <h1>{post.data.title}</h1>
      <Content />
      <hr />
      {(prev || next) && (
        <nav class="pager" aria-label="Series">
          {prev && (
            <a class="prev" href={`/articles/${prev.id}`}>
              <span class="lbl">← Previous</span>
              <span>{prev.data.title}</span>
            </a>
          )}
          {next && (
            <a class="next" href={`/articles/${next.id}`}>
              <span class="lbl">Next →</span>
              <span>{next.data.title}</span>
            </a>
          )}
        </nav>
      )}
      <p class="sec-link"><a href="/articles">← All articles</a></p>
    </article>
  </div>
</Base>
