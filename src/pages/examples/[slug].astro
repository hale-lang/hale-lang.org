---
import Base from '../../layouts/Base.astro';
import Field from '../../components/Field.astro';
import Hale from '../../components/Hale.astro';
import captures from '../../generated/examples.json';

/*
  A literate full example: prose and code in program order, where
  the code sections concatenate to the exact program the build
  checked, ran, broke, and (where it applies) recorded and
  replayed. Evidence blocks come from src/generated/examples.json;
  nothing is transcribed by hand.
*/
export async function getStaticPaths() {
  const mods = import.meta.glob('../../examples/full/*.mjs', {
    eager: true,
  });
  return Object.values(mods).map((m: any) => ({
    params: { slug: m.full.slug },
    props: { full: m.full },
  }));
}
const { full } = Astro.props;
const cap = (captures as any).fulls?.[full.slug] ?? { sections: {} };
const sec = (id: string) => cap.sections?.[id] ?? {};
const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
// Section prose is plain text with `code` spans.
const prose = (t: string) => esc(t).replace(/`([^`]+)`/g, '<code>$1</code>');
---

<Base title={full.title} description={full.tagline}>
  <Field />
  <section class="wrap page">
    <div class="page-head">
      <h1>{full.title}</h1>
      <p class="lede" set:html={prose(full.intro)} />
      <p class="meta-line">
        {cap.lines} lines · verified by <code>{(captures as any).hale.split('\n')[0]}</code> at build time · <a href={`/examples/${full.slug}.hl`}>download {full.file ?? 'the program'}</a>
      </p>
    </div>
    <div class="prose">
      {full.sections.map((s: any) => {
        const c = sec(s.id);
        const brkFind = s.brk?.find ?? '';
        return (
          <div class="lit-section">
            <p set:html={prose(s.prose)} />
            {s.code && <Hale code={s.code} title={s.file ?? full.file} />}
            {s.brk && (
              <>
                <pre class="diff"><span class="note">{s.brk.note}</span>{'\n'}{brkFind.split('\n').map((l: string) => `- ${l}`).join('\n')}{'\n'}{s.brk.replace.split('\n').filter((l: string) => !brkFind.includes(l)).map((l: string) => `+ ${l}`).join('\n')}</pre>
                {c.brk && <pre class="machine err"><span class="label">$ hale check {full.file}</span>{'\n'}{c.brk.output}</pre>}
              </>
            )}
            {c.run && c.run.outputs.map((o: string, i: number) => (
              <pre class="machine run"><span class="label">$ hale run {full.file}{c.run.outputs.length > 1 ? `   # run ${i + 1}` : ''}</span>{'\n'}{o}</pre>
            ))}
            {c.fleet && <pre class="machine run"><span class="label">$ hale check --dump-topology …  &amp;&amp;  hale fleet check plan.json</span>{'\n'}{c.fleet.output}</pre>}
            {c.fleetBreak && (() => {
              const k = s.captures?.find((x: any) => x.kind === 'fleet-break');
              return (
                <>
                  {k && <pre class="diff"><span class="note">{k.note} ({k.file})</span>{'\n'}{`- ${k.find.trim()}`}{'\n'}{`+ ${k.replace.trim()}`}</pre>}
                  <pre class="machine err"><span class="label">$ hale fleet check plan.json</span>{'\n'}{c.fleetBreak.output}</pre>
                </>
              );
            })()}
            {c.session && (
              <pre class="machine run"><span class="label">$ {(s.captures?.find((x: any) => x.kind === 'session')?.steps ?? []).join('\n$ ')}</span>{'\n'}{c.session.output}{c.session.source === 'pinned' ? `\n\n# ${c.session.label}` : ''}</pre>
            )}
          </div>
        );
      })}
      <p class="sec-link" style="margin-top:var(--s12)"><a href="/examples">← All examples</a></p>
    </div>
  </section>
</Base>
