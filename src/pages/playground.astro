---
import Base from '../layouts/Base.astro';
import Field from '../components/Field.astro';
---
<Base title="Hale playground">
  <Field kind="playground" />
  <section class="container prose play-page">
    <span class="tag">/playground</span>
    <h1>Playground</h1>
    <p class="lede">
      Write and run real Hale in your browser. Your source is compiled to
      {' '}<code>WebAssembly</code> by a compile service written in Hale itself,
      and the result runs fully client-side. The compiler doing the work is
      the same one you install locally.
    </p>

    <div class="play-frame">
      <iframe src="https://play.hale-lang.org/" title="Hale playground" loading="lazy"></iframe>
    </div>

    <div class="hero-actions" style="margin-top:1.25rem;">
      <a class="btn btn-ghost" href="https://play.hale-lang.org/" target="_blank" rel="noopener">Open full screen ↗</a>
      <a class="btn btn-ghost" href="/play/" target="_blank" rel="noopener">Guided example tour ↗</a>
      <a class="btn btn-ghost" href="/docs/getting-started/install">Install locally →</a>
    </div>
  </section>
</Base>

<style>
  .play-frame {
    margin-top: 1.5rem;
    /* An editor is not prose, break it out of the reading measure and
       centre it on the viewport, the way the model page's map does. */
    width: min(var(--maxw-wide), calc(100vw - 48px));
    margin-left: 50%;
    transform: translateX(-50%);
    border: 1px solid var(--border, #2a2f3a);
    border-radius: 12px;
    overflow: hidden;
    background: #050914;
  }
  .play-frame iframe {
    display: block;
    width: 100%;
    /* fill the viewport below the page chrome; never shrink into a slot */
    height: calc(100vh - 340px);
    min-height: 560px;
    border: 0;
  }
</style>
