---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props { title?: string; description?: string; }
const {
  title = 'Hale: one structure, from a value to a fleet',
  // Read cold, in a search result, by someone who has never heard of Hale —
  // so this stays in the factual register. "Say less. Spell more." is the
  // line to remember, not the line to explain with.
  description = "Hale compresses whole-system meaning into one scale-invariant construct: the locus. From value to fleet, structure, behavior, topology, effects, and architectural law compose in a single language the compiler can certify.",
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hale" />
    {/* Absolute, because most scrapers will not resolve a relative one.
        See scripts/og-card.html for the source of the image. */}
    <meta property="og:image" content="https://hale-lang.org/og.png" />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta property="og:image:alt" content="Hale — a concurrent systems language with a model-checked, GC-free runtime." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://hale-lang.org/og.png" />
    <meta name="theme-color" content="#0e7c66" />
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
