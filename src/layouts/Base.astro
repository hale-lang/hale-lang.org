---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props { title?: string; description?: string; }
const {
  title = 'Hale: a general-purpose, native, memory-safe language',
  // Read cold, in a search result, by someone who has never heard of Hale —
  // so this stays in the factual register, and it now leads with the
  // CATEGORY (the repositioning brief's diagnosis: the old line read as a
  // distributed-systems DSL to a stranger). The recursive-model claim is
  // still here — as the second sentence, where it lands as a property of
  // an ordinary language rather than an entry requirement.
  description = "Hale is a general-purpose language for scripts, services, and systems: ordinary functions, CLIs, files, JSON, HTTP, and WebAssembly. As a program grows, the same language keeps ownership, concurrency, placement, effects, and architectural rules visible to the compiler — one recursive model, from function scope to fleet.",
} = Astro.props;
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hale" />
    {/* Absolute, because most scrapers will not resolve a relative one.
        See scripts/og-card.html for the source of the image. */}
    <meta property="og:image" content="https://hale-lang.org/og.png" />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta property="og:image:alt" content="Hale — a general-purpose language, from scripts to systems." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://hale-lang.org/og.png" />
    <meta name="theme-color" content="#02040a" />
    <meta name="color-scheme" content="dark" />
    {/*
      The digital-lotus reskin is dark only: data-theme is pinned in the
      markup above, so there is no pre-paint theme script to run and
      nothing to flash. Starlight resolves its own data-theme on the docs;
      starlight.css maps both of its values onto the same palette.
    */}
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
