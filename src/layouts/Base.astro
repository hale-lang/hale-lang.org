---
import '../styles/global.css';
import '../styles/nav.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { structuredData } from '../data/structured-data.mjs';

interface Props { title?: string; description?: string; }
const {
  // The homepage's title leads with the category: it is the strongest
  // signal a search engine reads. Every other page names itself and the
  // brand, as the docs do.
  title = 'Hale programming language: less language, more compiler',
  // Read cold, in a search result, by someone who has never heard of
  // Hale: what it does for an application, in plain terms.
  description = 'Hale is a compiled language that checks your architecture on every build, gives you concurrency with no locks or data races, runs the same code as a test, one binary or a fleet, frees memory with no garbage collector, keeps units on money and time, and grows a script into a service without changing tools.',
} = Astro.props;
const home = Astro.url.pathname === '/';
const fullTitle = home ? title : `${title} | Hale`;
// One URL per page for crawlers, absolute, from the configured site.
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://hale-lang.org').href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <link rel="canonical" href={canonical} />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:url" content={canonical} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hale" />
    {/* Absolute, because most scrapers will not resolve a relative one.
        See scripts/og-card.html for the source of the image. */}
    <meta property="og:image" content="https://hale-lang.org/og.png" />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta property="og:image:alt" content="Hale: less language, more compiler." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://hale-lang.org/og.png" />
    {home && <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#03060e" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f4f8fd" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" />
    {/* Dark-first by default: only explicit 'light' selection switches to light mode. */}
    <script is:inline>
      (() => {
        let stored = '';
        try { stored = localStorage.getItem('starlight-theme') || ''; } catch (e) {}
        const theme = stored === 'light' ? 'light' : 'dark';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
