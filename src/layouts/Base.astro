---
import '../styles/global.css';
import '../styles/nav.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props { title?: string; description?: string; }
const {
  title = 'Hale: less language, more compiler',
  // Read cold, in a search result, by someone who has never heard of
  // Hale: what it does for an application, in plain terms.
  description = 'Hale is a compiled language that checks your architecture on every build, gives you concurrency with no locks or data races, runs the same code as a test, one binary or a fleet, frees memory with no garbage collector, keeps units on money and time, and grows a script into a service without changing tools.',
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hale" />
    {/* Absolute, because most scrapers will not resolve a relative one.
        See scripts/og-card.html for the source of the image. */}
    <meta property="og:image" content="https://hale-lang.org/og.png" />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta property="og:image:alt" content="Hale: less language, more compiler." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://hale-lang.org/og.png" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fbf6ec" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#131015" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,500;0,7..72,600;1,7..72,400;1,7..72,500&family=JetBrains+Mono:wght@400;500;700&display=swap" />
    {/* Resolve the theme before first paint, exactly as Starlight's own
        provider does in the docs: a stored choice, else the system. */}
    <script is:inline>
      (() => {
        let stored = '';
        try { stored = localStorage.getItem('starlight-theme') || ''; } catch (e) {}
        const theme = stored || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        document.documentElement.dataset.theme = theme === 'light' ? 'light' : 'dark';
      })();
    </script>
  </head>
  <body>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
