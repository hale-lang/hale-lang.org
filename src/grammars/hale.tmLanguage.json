{
  "name": "hale",
  "scopeName": "source.hale",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#units"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#annotations"
    },
    {
      "include": "#lifecycle"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.hale",
          "match": "//.*$"
        },
        {
          "name": "comment.block.hale",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.bytes.hale",
          "begin": "b\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.hale",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.interpolated.hale",
          "begin": "f\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.hale",
              "match": "\\\\."
            },
            {
              "name": "meta.embedded.hale",
              "begin": "\\{",
              "end": "\\}",
              "patterns": [
                {
                  "include": "$self"
                }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.raw.hale",
          "begin": "r\"",
          "end": "\""
        },
        {
          "name": "string.quoted.double.hale",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.hale",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.time.hale",
          "begin": "`",
          "end": "`"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.hale",
          "match": "\\b0[xX][0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.oct.hale",
          "match": "\\b0[oO][0-7_]+\\b"
        },
        {
          "name": "constant.numeric.bin.hale",
          "match": "\\b0[bB][01_]+\\b"
        },
        {
          "name": "constant.numeric.decimal.hale",
          "match": "\\b[0-9][0-9_]*(?:\\.[0-9][0-9_]*)?(?:[eE][+-]?[0-9]+)?d\\b"
        },
        {
          "name": "constant.numeric.float.hale",
          "match": "\\b[0-9][0-9_]*(?:\\.[0-9][0-9_]*(?:[eE][+-]?[0-9]+)?|[eE][+-]?[0-9]+)\\b"
        },
        {
          "name": "constant.numeric.quantity.hale",
          "match": "\\b[0-9][0-9_]*([A-Za-z][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "entity.name.type.unit.hale"
            }
          }
        },
        {
          "name": "constant.numeric.integer.hale",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "units": {
      "patterns": [
        {
          "name": "meta.declaration.unit.hale",
          "begin": "^\\s*(unit)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(?=[=;])",
          "beginCaptures": {
            "1": {
              "name": "storage.type.declaration.hale"
            },
            "2": {
              "name": "entity.name.type.unit.hale"
            }
          },
          "end": ";",
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#numbers"
            },
            {
              "name": "entity.name.type.unit.hale",
              "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
            },
            {
              "include": "#operators"
            }
          ]
        },
        {
          "match": "\\b([A-Z][A-Za-z0-9_]*)\\s+(in)\\s+(?:([0-9][0-9_]*)\\s*)?([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": {
              "patterns": [
                {
                  "include": "#types"
                }
              ]
            },
            "2": {
              "name": "keyword.control.flow.hale"
            },
            "3": {
              "name": "constant.numeric.integer.hale"
            },
            "4": {
              "name": "entity.name.type.unit.hale"
            }
          }
        },
        {
          "match": "\\b(origin)\\s*(:)\\s*(-?)\\s*([0-9][0-9_]*)\\s*([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "keyword.other.unit.hale"
            },
            "3": {
              "name": "keyword.operator.hale"
            },
            "4": {
              "name": "constant.numeric.integer.hale"
            },
            "5": {
              "name": "entity.name.type.unit.hale"
            }
          }
        },
        {
          "match": "(\\.)(in)(\\()\\s*(?:([0-9][0-9_]*)\\s*)?([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\))",
          "captures": {
            "2": {
              "name": "keyword.control.flow.hale"
            },
            "4": {
              "name": "constant.numeric.integer.hale"
            },
            "5": {
              "name": "entity.name.type.unit.hale"
            }
          }
        },
        {
          "match": "(\\.)(split)(\\()\\s*(?:([0-9][0-9_]*)\\s*)?([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\))",
          "captures": {
            "2": {
              "name": "entity.name.function.call.hale"
            },
            "4": {
              "name": "constant.numeric.integer.hale"
            },
            "5": {
              "name": "entity.name.type.unit.hale"
            }
          }
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "name": "meta.annotation.hale",
          "match": "@(form|ffi|locality)\\b",
          "captures": {
            "0": {
              "name": "entity.name.function.decorator.hale"
            }
          }
        }
      ]
    },
    "lifecycle": {
      "patterns": [
        {
          "name": "keyword.control.lifecycle.hale",
          "match": "\\b(birth|accept|release|run|drain|dissolve|on_failure)\\b"
        },
        {
          "name": "keyword.control.recovery.hale",
          "match": "\\b(restart|restart_in_place|quarantine|reorganize|bubble|violate|terminate)\\b"
        },
        {
          "name": "keyword.control.mode.hale",
          "match": "\\b(mode|bulk|harmonic|resolution)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "storage.type.declaration.hale",
          "match": "\\b(locus|type|interface|perspective|fn|const|import|export|module|topic|ring_layout|main|trait|impl|macro|unit|constitution)\\b"
        },
        {
          "name": "keyword.other.unit.hale",
          "match": "\\b(quantity|point|distinct)\\b"
        },
        {
          "match": "\\b(round)\\s*(:)\\s*(floor|ceil|trunc|half_even|half_up)\\b",
          "captures": {
            "1": {
              "name": "keyword.other.unit.hale"
            },
            "3": {
              "name": "keyword.other.policy.hale"
            }
          }
        },
        {
          "name": "keyword.other.unit.hale",
          "match": "\\b(range|round|origin)(?=\\s*:(?!:))"
        },
        {
          "match": "\\b(or)\\s+(floor|ceil|trunc|half_even|half_up|clamp|wrap)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.fallible.hale"
            },
            "2": {
              "name": "keyword.other.policy.hale"
            }
          }
        },
        {
          "name": "keyword.other.api.hale",
          "match": "\\b(api|serve|serves|http|principals|gated|includes|roles|on_unauthorized|on_full|refuse|watch_bound|on_watch_full)\\b"
        },
        {
          "name": "storage.type.declaration.claims.hale",
          "match": "\\b(group|domain|effect)\\b"
        },
        {
          "name": "keyword.other.claims.hale",
          "match": "\\b(claims|forbid|reaches|via|during|avoiding|edges|bound|require|cover|count|seed|subscribes|publishes|publishers|subscribers|subscribed_by|some|paths|from|may_be_empty|effects|adopt|extends)\\b"
        },
        {
          "name": "keyword.other.member.hale",
          "match": "\\b(params|contract|bus|capacity|bindings|placement|closure|as_parent_for|indexed_by|birth_check)\\b"
        },
        {
          "name": "keyword.other.bus.hale",
          "match": "\\b(subscribe|publish|expose|consume|inferred|keyed_by|on_unmatched|payload|subject|on_overflow|block|drop|slot_count|shm_ring|unix|role|listen|connect)\\b"
        },
        {
          "name": "keyword.other.placement.hale",
          "match": "\\b(cooperative|pinned|pool|core|cores|heap|projection|rich|chunked|recognition|tier|capacity|topology|node|l3|reserve|replicas|schedule|fixed_cell|shared_slab|spillover|summary_only|cap|inline|intra_process|intra_machine|cross_machine|zero_copy|reperspective)\\b"
        },
        {
          "name": "keyword.other.closure.hale",
          "match": "\\b(epoch|within|approx|captures|persists_through|resets_on|resets_per_epoch|stable_when|serialize_as|where|tick|duration|explicit|with|until|sum|prod)\\b"
        },
        {
          "name": "keyword.control.fallible.hale",
          "match": "\\b(fallible|fail|or|raise|discard|wait)\\b"
        },
        {
          "name": "keyword.control.flow.hale",
          "match": "\\b(if|else|match|for|in|while|return|break|continue|yield|async|await)\\b"
        },
        {
          "name": "keyword.other.binding.hale",
          "match": "\\b(let|mut|as|of|on)\\b"
        },
        {
          "name": "variable.language.hale",
          "match": "\\b(self)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.hale",
          "match": "\\b(Int|Uint|Float|Decimal|String|Bool|Time|Duration|Bytes|BytesView|BytesMut|StringView)\\b"
        },
        {
          "name": "entity.name.type.hale",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.hale",
          "match": "\\b(true|false|nil)\\b"
        },
        {
          "name": "constant.other.hale",
          "match": "\\b[A-Z][A-Z0-9_]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.send.hale",
          "match": "<-"
        },
        {
          "name": "keyword.operator.approx.hale",
          "match": "~~"
        },
        {
          "name": "keyword.operator.arrow.hale",
          "match": "->|=>"
        },
        {
          "name": "keyword.operator.hale",
          "match": "(==|!=|<=|>=|&&|\\|\\||[-+*/%<>=!&|^~])"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.call.hale",
          "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=\\()"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.hale",
          "match": "\\b[a-z_][A-Za-z0-9_]*\\b"
        }
      ]
    }
  }
}