{
  "name": "hale-dark",
  "type": "dark",
  "colors": {
    "editor.background": "#040813",
    "editor.foreground": "#eef5ff",
    "editor.selectionBackground": "#102244"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "comment.line",
        "comment.block",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5c7399",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.interpolated",
        "constant.character.escape",
        "string.quoted.double.json"
      ],
      "settings": {
        "foreground": "#7df4ff"
      }
    },
    {
      "scope": [
        "string.quoted.time.hale"
      ],
      "settings": {
        "foreground": "#ffca58"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.numeric.json"
      ],
      "settings": {
        "foreground": "#ffca58"
      }
    },
    {
      "scope": [
        "meta.annotation",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#00e5ff",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.other"
      ],
      "settings": {
        "foreground": "#b084ff",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#9bb0d1"
      }
    },
    {
      "scope": [
        "keyword.operator.send.hale"
      ],
      "settings": {
        "foreground": "#ff4d88",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "variable.language",
        "constant.language",
        "constant.language.json",
        "constant.other.hale"
      ],
      "settings": {
        "foreground": "#ff4d88",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "support.type",
        "entity.name.type",
        "entity.name.type.unit.hale",
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#00f5c4"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "entity.name.function.call",
        "support.function"
      ],
      "settings": {
        "foreground": "#52a8ff"
      }
    },
    {
      "scope": [
        "variable.other",
        "meta.embedded",
        "punctuation"
      ],
      "settings": {
        "foreground": "#eef5ff"
      }
    }
  ]
}
