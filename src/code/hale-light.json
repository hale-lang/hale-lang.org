{
  "name": "hale-light",
  "type": "light",
  "colors": {
    "editor.background": "#f3ebdc",
    "editor.foreground": "#1c1814",
    "editor.selectionBackground": "#eadfcc"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "comment.line",
        "comment.block",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7a6f64",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.interpolated",
        "constant.character.escape",
        "string.quoted.double.json"
      ],
      "settings": {
        "foreground": "#b4442a"
      }
    },
    {
      "scope": [
        "string.quoted.time.hale"
      ],
      "settings": {
        "foreground": "#9a6600"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.numeric.json"
      ],
      "settings": {
        "foreground": "#9a6600"
      }
    },
    {
      "scope": [
        "meta.annotation",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#9a6600",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.other"
      ],
      "settings": {
        "foreground": "#6a3fc9",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#1c1814"
      }
    },
    {
      "scope": [
        "keyword.operator.send.hale"
      ],
      "settings": {
        "foreground": "#c2256b",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "variable.language",
        "constant.language",
        "constant.language.json",
        "constant.other.hale"
      ],
      "settings": {
        "foreground": "#c2256b",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "support.type",
        "entity.name.type",
        "entity.name.type.unit.hale",
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#1e7a5a"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "entity.name.function.call",
        "support.function"
      ],
      "settings": {
        "foreground": "#2457c5"
      }
    },
    {
      "scope": [
        "variable.other",
        "meta.embedded",
        "punctuation"
      ],
      "settings": {
        "foreground": "#1c1814"
      }
    }
  ]
}
