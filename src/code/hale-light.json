{
  "name": "hale-light",
  "type": "light",
  "colors": {
    "editor.background": "#edf3fb",
    "editor.foreground": "#091326",
    "editor.selectionBackground": "#cfe2fa"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "comment.line",
        "comment.block",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5d7394",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.interpolated",
        "constant.character.escape",
        "string.quoted.double.json"
      ],
      "settings": {
        "foreground": "#006994"
      }
    },
    {
      "scope": [
        "string.quoted.time.hale"
      ],
      "settings": {
        "foreground": "#a65e00"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.numeric.json"
      ],
      "settings": {
        "foreground": "#a65e00"
      }
    },
    {
      "scope": [
        "meta.annotation",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#0077a8",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.other"
      ],
      "settings": {
        "foreground": "#5e35b1",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#364b6d"
      }
    },
    {
      "scope": [
        "keyword.operator.send.hale"
      ],
      "settings": {
        "foreground": "#c2185b",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "variable.language",
        "constant.language",
        "constant.language.json",
        "constant.other.hale"
      ],
      "settings": {
        "foreground": "#c2185b",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "support.type",
        "entity.name.type",
        "entity.name.type.unit.hale",
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#007a5e"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "entity.name.function.call",
        "support.function"
      ],
      "settings": {
        "foreground": "#1e56c5"
      }
    },
    {
      "scope": [
        "variable.other",
        "meta.embedded",
        "punctuation"
      ],
      "settings": {
        "foreground": "#091326"
      }
    }
  ]
}
