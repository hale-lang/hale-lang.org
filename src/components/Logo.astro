---
/*
  The digital lotus: a geometric luminous lotus held inside an orbital
  system. The artwork lives in public/favicon.svg — one file serves the
  browser tab, the docs logo, and every inline use, and referencing it as
  an <img> keeps its internal gradient/filter ids from colliding when the
  mark appears twice on a page (header and footer).
*/
interface Props { class?: string; }
const { class: cls = 'mark' } = Astro.props;
---
<img class={cls} src="/favicon.svg" alt="" aria-hidden="true" width="160" height="160" />
