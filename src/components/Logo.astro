---
// Geometric lotus mark: doubles as the "tower of nested loci" motif.
interface Props { class?: string; }
const { class: cls = 'mark' } = Astro.props;
---
<svg class={cls} viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
     aria-hidden="true">
  <path d="M12 3.5 C 13.7 7, 13.7 10, 12 12.6 C 10.3 10, 10.3 7, 12 3.5 Z" />
  <path d="M12 12.6 C 8.9 10.6, 6.2 11.1, 4.7 13.2 C 7.3 14.9, 10 14.6, 12 12.6 Z" />
  <path d="M12 12.6 C 15.1 10.6, 17.8 11.1, 19.3 13.2 C 16.7 14.9, 14 14.6, 12 12.6 Z" />
  <path d="M4 13.8 C 6.2 19.2, 17.8 19.2, 20 13.8" />
</svg>
