---
/*
  An inner page's band: the lotus field opened flat, with the page's own
  path under it. Every page outside the docs opens with one, so the field
  is the thread between them.
*/
import LotusField from './LotusField.astro';
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
---
<div class="band">
  <LotusField />
  <div class="wrap path">{path}</div>
</div>
