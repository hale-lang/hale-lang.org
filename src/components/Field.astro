---
/*
  A page's own weather.

  Same fluid, same cavities, same light: what differs is what the cavities
  are doing, and each page gets the behaviour that belongs to it. The
  homepage owns the scroll camera (see Unfold); these are ambient bands
  that sit above a page's title.
*/
interface Props { kind: string; label?: string; }
const { kind, label } = Astro.props;
---

<div class={`field field-${kind}`} data-kind={kind} aria-hidden="true">
  <canvas class="field-canvas"></canvas>
  {label && <span class="field-label">{label}</span>}
</div>

<style>
  .field {
    position: relative;
    width: 100%;
    height: clamp(150px, 22vw, 260px);
    background: #05070a;
    overflow: hidden;
    /* Dissolve into whatever the page background is, so the band reads as
       part of the page rather than a widget dropped on top of it. */
    -webkit-mask-image: linear-gradient(to bottom, #000 55%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 55%, transparent 100%);
  }
  .field-canvas { display: block; width: 100%; height: 100%; }
  .field-label {
    position: absolute;
    left: 50%;
    bottom: 1.1rem;
    transform: translateX(-50%);
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(46, 196, 163, 0.75);
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .field { height: clamp(110px, 14vw, 170px); }
  }
</style>

<script>
  import {
    mount, bakeTile, medium, cavity, spark, topicLine, viaTopic,
    HUES, clamp01, lerp, outCubic,
  } from '../lib/field';

  type F = Parameters<Parameters<typeof mount>[2]>[0];
  const TAU = Math.PI * 2;

  /* Each scene answers one question about the page it sits on. */
  const scenes: Record<string, (f: F) => void> = {

    /* /model: three graphs, and Hale knows how they meet. Ownership,
       communication and placement take the foreground in turn. */
    model(f) {
      const { ctx, W, H, t } = f;
      medium(f, [HUES.cyan, HUES.jade, HUES.violet]);
      const phase = (t / 6) % 3;
      const lit = (i: number) => 0.25 + 0.75 * Math.max(0, 1 - Math.abs(phase - i) * 1.6);
      const cxs = [0.22, 0.5, 0.78].map((u) => u * W);
      const y = H * 0.52, r = Math.min(H * 0.3, W * 0.09);

      // placement: lanes behind
      for (let i = 0; i < 3; i++) {
        const g = ctx.createLinearGradient(0, 0, 0, H);
        g.addColorStop(0, `rgba(${HUES.violet},0)`);
        g.addColorStop(0.5, `rgba(${HUES.violet},${0.07 * lit(2)})`);
        g.addColorStop(1, `rgba(${HUES.violet},0)`);
        ctx.fillStyle = g;
        ctx.fillRect(cxs[i] - r * 1.5, 0, r * 3, H);
      }
      // ownership: parent above, children below
      const px = W * 0.5, py = H * 0.16;
      ctx.strokeStyle = `rgba(${HUES.cyan},${0.3 * lit(0)})`;
      ctx.lineWidth = 1;
      for (const cx of cxs) {
        ctx.beginPath();
        ctx.moveTo(px, py);
        ctx.quadraticCurveTo(px, (py + y) / 2, cx, y);
        ctx.stroke();
      }
      cavity(f, px, py, r * 0.5, HUES.cyan, { alpha: lit(0) });
      // communication: a topic above, a message crossing it
      topicLine(f, H * 0.08, lit(1) * 0.9);
      const k = (t * 0.3) % 1;
      for (let i = 0; i < 5; i++) {
        const kk = k - i * 0.03;
        if (kk <= 0) continue;
        const [mx, my] = viaTopic(cxs[0], y, cxs[2], y, H * 0.08, kk);
        spark(f, mx, my, 10 - i * 1.4, (1 - i / 5) * lit(1));
      }
      for (let i = 0; i < 3; i++) cavity(f, cxs[i], y, r, [HUES.cyan, HUES.jade, HUES.gold][i]);
    },

    /* /proof: a witness. Light walks the graph and is refused at the
       boundary a claim forbids, which is the whole shape of a countermodel. */
    proof(f) {
      const { ctx, W, H, t } = f;
      medium(f, [HUES.jade, HUES.cyan, HUES.jade], 0.8);
      const y = H * 0.55, r = Math.min(H * 0.2, W * 0.055);
      const xs = [0.16, 0.38, 0.62, 0.85].map((u) => u * W);
      const gate = (xs[2] + xs[3]) / 2;

      const cyc = (t * 0.35) % 1;
      const reach = cyc * (xs[3] - xs[0]) + xs[0];
      const blocked = reach >= gate;
      const x = blocked ? gate : reach;

      // the forbidden boundary
      const flare = blocked ? 1 - clamp01((reach - gate) / (xs[3] - gate)) : 0;
      ctx.strokeStyle = `rgba(${HUES.rose},${0.2 + 0.55 * flare})`;
      ctx.lineWidth = 1.4;
      ctx.setLineDash([5, 8]);
      ctx.beginPath();
      ctx.moveTo(gate, H * 0.12);
      ctx.lineTo(gate, H * 0.92);
      ctx.stroke();
      ctx.setLineDash([]);

      ctx.strokeStyle = `rgba(${HUES.jade},0.22)`;
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(xs[0], y);
      ctx.lineTo(xs[3], y);
      ctx.stroke();

      for (let i = 0; i < 4; i++) {
        const past = xs[i] < x - 2;
        cavity(f, xs[i], y, r, i === 3 ? HUES.rose : HUES.jade, { alpha: past ? 1 : 0.55 });
      }
      for (let i = 0; i < 7; i++) {
        const xx = x - i * 9;
        if (xx < xs[0]) continue;
        spark(f, xx, y, 12 - i * 1.3, (1 - i / 7) * 0.9, blocked ? HUES.rose : HUES.gold);
      }
      if (blocked) spark(f, gate, y, 26 * flare, flare * 0.7, HUES.rose);
    },

    /* /features: an inventory. A lattice, each cell breathing in turn. */
    features(f) {
      const { W, H, t } = f;
      medium(f, [HUES.jade, HUES.cyan, HUES.gold], 0.7);
      const cols = Math.max(6, Math.round(W / 140)), rows = 3;
      const r = Math.min(H / (rows * 3.4), W / (cols * 3.2));
      for (let iy = 0; iy < rows; iy++) {
        for (let ix = 0; ix < cols; ix++) {
          const x = ((ix + 0.5) / cols) * W;
          const y = ((iy + 0.5) / rows) * H;
          const ph = (ix * 0.5 + iy * 1.1 - t * 1.1) % 6;
          const a = 0.32 + 0.68 * Math.max(0, 1 - Math.abs(ph) * 0.9);
          cavity(f, x, y, r * (0.7 + a * 0.5), [HUES.jade, HUES.cyan, HUES.gold, HUES.violet][(ix + iy) % 4],
            { alpha: a, caustic: false });
        }
      }
    },

    /* /tooling: one loop: edit, check, witness, edit. */
    tooling(f) {
      const { ctx, W, H, t } = f;
      medium(f, [HUES.jade, HUES.gold, HUES.cyan], 0.75);
      const cx = W / 2, cy = H * 0.54;
      const rx = Math.min(W * 0.3, 320), ry = Math.min(H * 0.3, 78);
      ctx.strokeStyle = `rgba(${HUES.jade},0.24)`;
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.ellipse(cx, cy, rx, ry, 0, 0, TAU);
      ctx.stroke();
      const stops = 4;
      for (let i = 0; i < stops; i++) {
        const a = (i / stops) * TAU - Math.PI / 2;
        cavity(f, cx + Math.cos(a) * rx, cy + Math.sin(a) * ry, Math.min(H * 0.13, 30),
          [HUES.cyan, HUES.jade, HUES.gold, HUES.violet][i], { alpha: 0.9 });
      }
      const k = (t * 0.22) % 1;
      for (let i = 0; i < 8; i++) {
        const a = (k - i * 0.012) * TAU - Math.PI / 2;
        spark(f, cx + Math.cos(a) * rx, cy + Math.sin(a) * ry, 13 - i * 1.2, (1 - i / 8) * 0.9);
      }
    },

    /* /examples: four shapes, each taking its turn. */
    examples(f) {
      const { W, H, t } = f;
      medium(f, [HUES.cyan, HUES.gold, HUES.jade], 0.7);
      const turn = (t / 3.2) % 4;
      for (let i = 0; i < 4; i++) {
        const cx = ((i + 0.5) / 4) * W, cy = H * 0.54;
        const on = Math.max(0, 1 - Math.abs(turn - i) * 1.4);
        const base = Math.min(H * 0.19, W * 0.05);
        cavity(f, cx, cy, base * (1 + on * 0.35), [HUES.cyan, HUES.jade, HUES.gold, HUES.violet][i],
          { alpha: 0.4 + 0.6 * on });
        const n = i + 2;
        for (let j = 0; j < n; j++) {
          const a = (j / n) * TAU + t * 0.2 + i;
          cavity(f, cx + Math.cos(a) * base * 0.95, cy + Math.sin(a) * base * 0.95,
            base * 0.22, HUES.jade, { alpha: (0.3 + 0.7 * on) * 0.9, caustic: false });
        }
      }
    },

    /* /packages: a pond. Cavities rise, and the surface keeps them. */
    packages(f) {
      const { W, H, t } = f;
      medium(f, [HUES.jade, HUES.cyan, HUES.jade], 0.7);
      for (let i = 0; i < 16; i++) {
        const sp = 0.05 + ((i * 37) % 11) / 42;
        const k = ((t * sp + i * 0.37) % 1);
        const x = (((i * 61) % 100) / 100) * W + Math.sin(t * 0.5 + i) * 12;
        const y = H * (1.1 - k * 1.25);
        const r = 4 + ((i * 13) % 7) * 2.6;
        cavity(f, x, y, r, [HUES.jade, HUES.cyan, HUES.gold][i % 3],
          { alpha: Math.min(1, k * 4) * (1 - clamp01((k - 0.75) / 0.25)), caustic: false });
      }
    },

    /* /community: two, finding an orbit. */
    community(f) {
      const { W, H, t } = f;
      medium(f, [HUES.cyan, HUES.jade, HUES.violet], 0.7);
      const cx = W / 2, cy = H * 0.54;
      const d = Math.min(W * 0.14, 150) * (0.72 + 0.28 * Math.sin(t * 0.35));
      const a = t * 0.24;
      const r = Math.min(H * 0.22, 46);
      cavity(f, cx + Math.cos(a) * d, cy + Math.sin(a) * d * 0.5, r, HUES.cyan);
      cavity(f, cx - Math.cos(a) * d, cy - Math.sin(a) * d * 0.5, r * 0.86, HUES.jade);
      const k = (t * 0.4) % 1;
      spark(f, lerp(cx + Math.cos(a) * d, cx - Math.cos(a) * d, k),
        lerp(cy + Math.sin(a) * d * 0.5, cy - Math.sin(a) * d * 0.5, k), 10, 0.7);
    },

    /* /playground: one cavity, breathing, waiting for input. */
    playground(f) {
      const { W, H, t } = f;
      medium(f, [HUES.jade, HUES.cyan, HUES.jade], 0.65);
      const r = Math.min(H * 0.3, W * 0.09) * (1 + Math.sin(t * 0.8) * 0.06);
      cavity(f, W / 2, H * 0.54, r, HUES.jade);
      // a caret, blinking at the same rate a cursor does
      if (((t * 1.4) % 2) < 1) spark(f, W / 2, H * 0.54, 9, 0.75, HUES.cyan);
    },

    /* /articles: a slow current, carrying things past. */
    articles(f) {
      const { W, H, t } = f;
      medium(f, [HUES.violet, HUES.jade, HUES.cyan], 0.65);
      for (let i = 0; i < 10; i++) {
        const k = ((t * 0.045 + i * 0.1) % 1.2) - 0.1;
        const x = k * W;
        const y = H * (0.24 + ((i * 29) % 10) / 19);
        const r = 8 + ((i * 17) % 5) * 5;
        cavity(f, x, y, r, [HUES.jade, HUES.cyan, HUES.violet][i % 3],
          { alpha: 0.5 * (1 - Math.abs(k - 0.5) * 1.3), caustic: false });
      }
    },
  };

  for (const el of document.querySelectorAll<HTMLElement>('.field')) {
    const cv = el.querySelector<HTMLCanvasElement>('.field-canvas');
    const scene = scenes[el.dataset.kind ?? ''];
    if (cv && scene) mount(cv, el, scene, 700_000);
  }

  /*
    The band is the loud statement; the rest of the page stands on the same
    ground, quietly. One still tile of the page's own scene, repeating down
    the document behind the content.

    Baked small and stretched to the page width: these are soft gradients,
    so the only seam that could show is the vertical one, and bakeTile
    cross-fades that away. Deliberately not animated — see bakeTile.
  */
  const band = document.querySelector<HTMLElement>('.field');
  const bandScene = band && scenes[band.dataset.kind ?? ''];
  if (band && bandScene) {
    // The medium is a dark fluid. Over dark paper it belongs; over the warm
    // light paper it can only ever be a stain, so it barely shows there.
    //
    // Follows the RESOLVED theme, not the OS preference. Those were the
    // same thing until the theme became selectable; keyed to the media
    // query, a reader who picks light on a dark machine gets the
    // full-strength wash over warm paper. The observer catches a toggle
    // without a reload — re-baking one tile is cheap.
    const isDark = () => document.documentElement.dataset.theme === 'dark';
    const wash = () => {
      const url = bakeTile(bandScene, 800, 300, isDark() ? 0.5 : 0.09);
      if (!url) return;
      document.body.style.backgroundImage = `url(${url})`;
      document.body.style.backgroundRepeat = 'repeat-y';
      document.body.style.backgroundSize = '100% auto';
    };
    // after the band has had the frame to itself
    requestAnimationFrame(() => requestAnimationFrame(wash));
    new MutationObserver(wash).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });
  }
</script>
