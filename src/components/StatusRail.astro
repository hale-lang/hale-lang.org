---
// "shipped" answers "is this implemented and specified", not "is this a
// compatibility promise"; the note under the rail says the difference.
import release from '../generated/release.json';
---
<div class="rail">
  <div><span class="st">shipped</span><b>Describe</b><small>loci, topics, ownership</small></div>
  <div><span class="st">shipped</span><b>Check</b><small>effects, causality, claims</small></div>
  <div><span class="st">shipped</span><b>Deploy</b><small>placement and bindings</small></div>
  <div><span class="st">shipped</span><b>Compose</b><small>law across deployed binaries</small></div>
  <div><span class="st">shipped</span><b>Observe</b><small>runtime topology and events</small></div>
  <div><span class="st">shipped</span><b>Replay</b><small>record + deterministic re-execution</small></div>
  <div class="rfc"><span class="st">rfc</span><b>Adapt</b><small>verified deployment transitions</small></div>
</div>
<p class="muted" style="margin-top:var(--s4);font-size:.92rem">
  <b>shipped</b> means implemented and specified, on v{release.minor}{release.prerelease ? ', a prerelease' : ''}. It is
  not a stability guarantee: syntax, artifact schemas and operational
  guarantees can still change before 1.0.
</p>
