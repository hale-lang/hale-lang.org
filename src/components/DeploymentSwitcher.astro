---
/*
  Five main blocks deploy the same two loci, Ingest and Rollup. The table
  repeats "Unchanged." down its last column until the repetition makes the
  point: only where the loci run and how the topic travels differs.

  The system is declared once in `_prelude`, which scripts/check-site.mjs
  prepends to every snippet in this file before `hale check`; nothing
  renders it.
*/
import Hale from './Hale.astro';

/*
  Offstage context, shared by every panel below. The whole point of this
  component is that these five `main` blocks differ and the system they
  deploy does not — so the system is declared once, here.
  scripts/check-site.mjs prepends `_prelude` to each snippet before running
  `hale check`. Nothing renders it.
*/
const _prelude = `type Sample { id: Int; value: Int; }

topic Samples { payload: Sample; }

locus Ingest {
    bus { publish Samples; }
    fn received(s: Sample) { Samples <- s; }
}

locus Rollup {
    bus { subscribe Samples as add; }
    fn add(s: Sample) { }
}

// Satisfies std::bus::Adapter — since hale 0.17 a bindings entry
// checks its locus against the interface (send, at minimum).
locus NatsAdapter {
    params { url: String = "nats://localhost:4222"; }

    fn send(subject: String, bytes: Bytes) { }
}
`;

const local = `main locus App {
    params {
        ingest: Ingest = Ingest { };
        rollup: Rollup = Rollup { };
    }
}`;

const pinned = `main locus App {
    params {
        ingest: Ingest = Ingest { };
        rollup: Rollup = Rollup { };
    }

    placement {
        ingest: pinned(core = 1);
        rollup: cooperative(pool = compute);
    }
}`;

const unix = `main locus App {
    params {
        ingest: Ingest = Ingest { };
        rollup: Rollup = Rollup { };
    }

    bindings {
        Samples: unix("/run/samples.sock", role: listen);
    }
}`;

const shared = `main locus App {
    params {
        ingest: Ingest = Ingest { };
        rollup: Rollup = Rollup { };
    }

    bindings {
        Samples: shm_ring("/samples",
            slot_count: 1024,
            on_overflow: drop)
            where intra_machine, zero_copy;
    }
}`;

const adapter = `main locus App {
    params {
        ingest: Ingest = Ingest { };
        rollup: Rollup = Rollup { };
    }

    bindings {
        Samples: NatsAdapter {
            url: "nats://prod:4222"
        };
    }
}`;
---
<div class="tbl-wrap">
<table class="bind">
  <thead>
    <tr><th scope="col">binding</th><th scope="col">main</th><th scope="col">what it does</th><th scope="col">ingest, rollup</th></tr>
  </thead>
  <tbody>
    <tr>
      <td class="name"><b>Local</b><code>main.local.hl</code></td>
      <td class="code"><Hale code={local} title="main.local.hl" /></td>
      <td><dl>
        <div><dt>Dispatch</dt><dd>A direct call where the compiler can prove it, otherwise the in-process bus.</dd></div>
        <div><dt>Boundary</dt><dd>One process, one ownership tree.</dd></div>
      </dl></td>
      <td class="same">ingest, rollup<b>Unchanged.</b></td>
    </tr>
    <tr>
      <td class="name"><b>Pinned</b><code>main.pinned.hl</code></td>
      <td class="code"><Hale code={pinned} title="main.pinned.hl" /></td>
      <td><dl>
        <div><dt>Execution</dt><dd>A dedicated core for ingest, a cooperative pool for rollup.</dd></div>
        <div><dt>Communication</dt><dd>The same typed topic, still in one process.</dd></div>
      </dl></td>
      <td class="same">ingest, rollup<b>Unchanged.</b></td>
    </tr>
    <tr>
      <td class="name"><b>Unix</b><code>main.unix.hl</code></td>
      <td class="code"><Hale code={unix} title="main.unix.hl" /></td>
      <td><dl>
        <div><dt>Transport</dt><dd>A framed Unix socket. Message boundaries are preserved.</dd></div>
        <div><dt>Failure</dt><dd>The transport is a child locus, so it is supervised like one.</dd></div>
      </dl></td>
      <td class="same">ingest, rollup<b>Unchanged.</b></td>
    </tr>
    <tr>
      <td class="name"><b>Shared memory</b><code>main.shm.hl</code></td>
      <td class="code"><Hale code={shared} title="main.shm.hl" /></td>
      <td><dl>
        <div><dt>Transport</dt><dd>A shared-memory ring for a high-rate edge on one machine.</dd></div>
        <div><dt>Policy</dt><dd>Capacity and overflow behaviour are declared at the seam.</dd></div>
      </dl></td>
      <td class="same">ingest, rollup<b>Unchanged.</b></td>
    </tr>
    <tr>
      <td class="name"><b>Adapter</b><code>main.adapter.hl</code></td>
      <td class="code"><Hale code={adapter} title="main.adapter.hl" /></td>
      <td><dl>
        <div><dt>Transport</dt><dd>A locus you wrote supplies the external broker.</dd></div>
        <div><dt>Contract</dt><dd>Ordering, retries and durability are the adapter's contract.</dd></div>
      </dl></td>
      <td class="same">ingest, rollup<b>Unchanged.</b></td>
    </tr>
  </tbody>
</table>
</div>
