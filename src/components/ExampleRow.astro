---
/*
  One example: the program and what the compiler says about it, beside a
  deliberate one-line break and the compiler's refusal. `cap` is this
  example's slice of src/generated/examples.json, written at build time by
  scripts/capture-examples.mjs from the compiler itself; nothing under a
  machine label is typed by hand.
*/
import Hale from './Hale.astro';

interface Props { ex: any; cap: any }
const { ex, cap: c } = Astro.props;
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const prose = esc(ex.prose).replace(/`([^`]+)`/g, '<code>$1</code>');
const del = (s: string) => s.split('\n').map((l) => `<span class="del">${esc(l)}</span>`).join('\n');
const add = (find: string, rep: string) =>
  rep.split('\n').filter((l) => !find.includes(l)).map((l) => `<span class="add">${esc(l)}</span>`).join('\n');
const diff = ex.brk
  ? [`<span class="note">${esc(ex.brk.note)}</span>`, del(ex.brk.find), add(ex.brk.find, ex.brk.replace),
     ...(ex.brk.extraFind ? [del(ex.brk.extraFind), add(ex.brk.extraFind, ex.brk.extraReplace)] : [])].join('\n')
  : '';
const hasBrk = Boolean(ex.brk || ex.session);
// Machine output as escaped strings: a label line, then what the compiler printed.
const machine = (label: string, body: string) => `<span class="label">${esc(label)}</span>\n${esc(body)}`;
const runHtml = c.run ? machine(`$ hale run ${ex.file}`, c.run.output) : '';
const brkHtml = ex.brk && c.brk ? machine(`$ hale check ${ex.file}`, c.brk.output) : '';
const sessionHtml = ex.session && c.session
  ? machine(`$ ${ex.session.steps.join('\n$ ')}`, c.session.output + (c.session.source === 'pinned' ? `\n\n# ${c.session.label}` : ''))
  : '';
---
<article class="ex" id={ex.id}>
  <div class="copy">
    <h2>{ex.title}</h2>
    <p set:html={prose} />
    <a href={ex.docs.href}>{ex.docs.label} →</a>
    {ex.play && <a href={ex.play.href} target="_blank" rel="noopener">{ex.play.label} ↗</a>}
  </div>
  <div class="panel">
    <input type="radio" name={`tab-${ex.id}`} id={`tab-${ex.id}-ok`} checked />
    {hasBrk && <input type="radio" name={`tab-${ex.id}`} id={`tab-${ex.id}-brk`} />}
    <div class="ptabs" role="radiogroup" aria-label="The program, or its break">
      <label for={`tab-${ex.id}-ok`}>program</label>
      {hasBrk && <label for={`tab-${ex.id}-brk`}>{ex.session ? 'record & replay' : 'break it'}</label>}
    </div>
    <div class="pane pane-ok">
      <Hale code={ex.program} title={ex.file} kind={ex.tier} />
      {runHtml && <pre class="machine run" set:html={runHtml} />}
    </div>
    {hasBrk && (
      <div class="pane pane-brk">
        {ex.brk && <pre class="diff" set:html={diff} />}
        {brkHtml && <pre class="machine err" set:html={brkHtml} />}
        {sessionHtml && <pre class="machine run" set:html={sessionHtml} />}
      </div>
    )}
  </div>
</article>
