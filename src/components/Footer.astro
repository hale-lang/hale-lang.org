---
import Logo from './Logo.astro';
// The long tail the header omits. Labels are one word wherever the
// destination allows it; `Semantic model` keeps its qualifier because
// `Model` is a different page beside it.
const cols = [
  { h: 'Start', links: [['Install', '/docs/getting-started/install'], ['Guide', '/docs'], ['Playground', '/playground']] },
  { h: 'Understand', links: [['Glossary', '/glossary'], ['Model', '/model'], ['Articles', '/articles'], ['Design', '/docs/the-design'], ['DNA', '/dna']] },
  { h: 'Reference', links: [['Language', '/features'], ['Spec', '/docs/reference'], ['Semantic model', '/docs/the-model'], ['Stdlib', '/docs/spec/stdlib'], ['Toolchain', '/tooling']] },
  { h: 'Project', links: [['Community', '/community'], ['GitHub', 'https://github.com/hale-lang'], ['Text-only', '/text'], ['llms.txt', '/llms.txt']] },
];
---
<footer class="foot">
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <a class="brand" href="/"><Logo /> hale</a>
        <p class="foot-note">
          Hale is open source under Apache-2.0, built on LLVM 18. The
          compiler checks the structure it can see and reports where it
          could not see.
        </p>
      </div>
      {cols.map((c) => (
        <div class="links">
          <h5>{c.h}</h5>
          {c.links.map(([label, href]) => <a href={href}>{label}</a>)}
        </div>
      ))}
    </div>
    <div class="colophon">
      <span>Hale is open source. © {new Date().getFullYear()} the Hale authors.</span>
      <span>Set in Literata and JetBrains Mono. Also available as <a href="/text">plain text</a>.</span>
    </div>
  </div>
</footer>
