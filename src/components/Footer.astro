---
import Logo from './Logo.astro';
const cols = [
  { h: 'Learn', links: [['Get started', '/docs/getting-started/install'], ['The guide', '/docs'], ['Concurrent services', '/docs/services/lifecycle'], ['Playground', '/playground']] },
  { h: 'Reference', links: [['Spec by topic', '/docs/reference'], ['Standard library', '/docs/spec/stdlib'], ['The design', '/docs/the-design'], ['Design rationale', '/docs/spec/design-rationale']] },
  { h: 'Ecosystem', links: [['Packages (pond)', '/packages'], ['Playground', '/playground'], ['Roadmap', '/roadmap']] },
  { h: 'Agents', links: [['For LLMs', '/agents'], ['Context pack', '/agents#context-pack'], ['MCP server', '/agents#mcp'], ['llms.txt', '/llms.txt']] },
];
---
<footer class="footer">
  <div class="container wide cols">
    <div>
      <a class="brand" href="/"><Logo /> hale</a>
      <p class="muted" style="font-size:0.88rem; margin-top:0.8rem; max-width:30ch;">
        A general-purpose language for robust, supervised systems —
        written fluently by humans and LLMs.
      </p>
    </div>
    {cols.map((c) => (
      <div>
        <h5>{c.h}</h5>
        {c.links.map(([label, href]) => <a href={href}>{label}</a>)}
      </div>
    ))}
  </div>
  <div class="container wide copy">
    Hale is open source. © {new Date().getFullYear()} the Hale authors.
    <span style="margin-left:0.5rem;"><a href="https://github.com/hale-lang">GitHub</a> · <a href="/community">Community</a></span>
  </div>
</footer>
