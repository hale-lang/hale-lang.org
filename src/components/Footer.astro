---
import Logo from './Logo.astro';
const cols = [
  // A footer earns its place by covering the LONG TAIL, not by
  // repeating the header. `Understand` gives the essays a home about
  // ideas rather than one about governance, and surfaces the two
  // model documents that nothing else on the site links to.
  { h: 'Start', links: [['Get started', '/docs/getting-started/install'], ['The guide', '/docs'], ['Examples', '/examples'], ['Playground', '/playground']] },
  { h: 'Understand', links: [['The programming model', '/model'], ['Writing', '/articles'], ['The design', '/docs/the-design'], ['Proof', '/proof']] },
  { h: 'Reference', links: [['Specification', '/docs/reference'], ['The semantic model', '/docs/the-model'], ['Standard library', '/docs/spec/stdlib'], ['Toolchain', '/tooling']] },
  { h: 'Project', links: [['Packages (pond)', '/packages'], ['Community', '/community'], ['GitHub', 'https://github.com/hale-lang'], ['Text-only site', '/text/'], ['llms.txt', '/llms.txt']] },
];
---
<footer class="footer">
  <div class="container wide cols">
    <div>
      <a class="brand" href="/"><Logo /> hale</a>
      {/* Both of the old sentences were absolutes on the most-repeated
          surface on the site: "one structural construct" (a fleet plan is
          JSON, not a locus declaration) and "the compiler certifies it"
          (it certifies named properties of an artifact, not the system).
          The footer is the wrong place to be the boldest. */}
      <p class="muted" style="font-size:0.88rem; margin-top:0.8rem; max-width:34ch;">
        One recursive model, from function scope to fleet composition. Hale
        checks the represented structure and emits evidence for the next
        boundary.
      </p>
    </div>
    {cols.map((c) => (
      <div>
        <h5>{c.h}</h5>
        {c.links.map(([label, href]) => <a href={href}>{label}</a>)}
      </div>
    ))}
  </div>
  <div class="container wide copy">
    Hale is open source. © {new Date().getFullYear()} the Hale authors.
  </div>
</footer>
