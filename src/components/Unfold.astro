---
/*
  Unfold: the recursion, over the lotus field.

  The digital-lotus field runs fixed behind the whole document: every lotus
  is a locus, every lit route is a declared communication edge, and packets
  travel those routes before the receiving lotus pulses. Scrolling pulls
  the camera back through the field, so the pull-back from one leaf toward
  the whole system is still the page's gesture — but the semantics now ride
  in the beats' code panels rather than in a bespoke scene.

  The beats carry what used to be four separate sections of the homepage
  (ownership, communication, execution, failure), because each of those is
  a property of the structure you are looking at rather than a topic of
  its own.
*/
import Hale from './Hale.astro';

/*
  One panel per beat, showing the thing the paragraph claims rather than
  illustrating it. Every Hale snippet here was checked with `hale check`
  against the compiler in the sibling checkout — the budget on the first
  one was rejected twice before it was actually zero-alloc, and the claims
  on the seventh were rejected as vacuous until the groups had behaviour to
  quantify over.

  The fleet plan is JSON, not Hale, and that exemption is exactly how it
  shipped routing a topic to a `gw-0` the plan never declared — the one
  defect on this page that the page's own argument says a compiler should
  catch. `hale fleet check` does catch it (fleet.rs: "names instance `{}`,
  which the plan does not declare"), so the plan is no longer exempt:
  scripts/check-site.mjs extracts every panel here and runs both checkers.
*/
const panels = [
  { title: 'frontier.hl', code: `effect io = { syscall, block };

@effects(none: {io})
@budget(alloc_per_call = 0)
fn checksum(seed: Int, n: Int) -> Int {
    let mut acc = seed;
    let mut i = 0;
    while i < n {
        acc = acc * 31 + i;
        i += 1;
    }
    return acc;
}` },
  { title: 'session.hl', code: `locus Session {
    params {
        id: Int = 0;
        seen: Int = 0;
    }

    fn record() {
        self.seen += 1;
    }
}
// dissolve frees the whole region.
// No collector walks it.` },
  { title: 'nesting.hl', code: `locus Shard {
    params { slot: Int = 0; }

    contract { expose slot: Int; }
}

locus Index {
    params { width: Int = 0; }

    contract { consume slot: Int; }

    accept(s: Shard) {
        self.width += 1;
    }
}` },
  { title: 'desk.hl', code: `type Order { id: Int; desk: String; }

topic Placed { payload: Order; keyed_by desk; }
topic Filled { payload: Order; }

locus Desk {
    params { name: String = "equities"; }

    bus {
        subscribe Placed as on_order where key == self.name;
        publish Filled;
    }

    fn on_order(o: Order) {
        Filled <- o;
    }
}` },
  { title: 'main.hl', code: `main locus App {
    params {
        workers: Worker = Worker { };
    }

    placement {
        workers: pinned(cores = 0..4, replicas = 4);
    }
}
// Four single-threaded replicas, one per core.
// Not one line of Worker changed.` },
  { title: 'supervise.hl', code: `locus Worker {
    params { valid: Int = 1; }

    closure must_be_valid {
        self.valid ~~ 1 within 0;
        epoch birth;
    }
}

locus Supervisor {
    on_failure(w: Worker, err: ClosureViolation) {
        println(err.locus, " broke ", err.closure);
        quarantine (w);
    }
}` },
  /*
    `prelude` is declarations the panel deliberately does not show — the
    loci and topics these claims quantify over. scripts/check-site.mjs
    prepends it before running `hale check`, so the snippet is genuinely
    checked (the groups resolve, so the claims are not vacuous) while the
    panel stays the four interesting lines. Nothing renders it.
  */
  { title: 'claims.hl',
    prelude: `topic Tasks { payload: Int; }

locus Planner {
    bus { publish Tasks; }
    fn plan(n: Int) { Tasks <- n; }
}
locus Worker {
    bus { subscribe Tasks as take; }
    fn take(n: Int) { }
}
locus Auditor {
    fn record(n: Int) { }
}
`,
    code: `group planners = { Planner };
group workers  = { Worker };
group audit    = { Auditor };

main locus Fleet {
    claims {
        isolated:   forbid reaches(planners, audit) via { calls };
        wired:      require subscribes(some workers, topic Tasks);
        one_writer: count publishers(topic Tasks) <= 1;
    }
}` },
  { title: 'constitution.hl',
    prelude: `topic Settled { payload: Int; }

locus Billing {
    bus { publish Settled; }
    fn settle(n: Int) { Settled <- n; }
}
locus Research {
    fn study(n: Int) { }
}
locus Ledger {
    bus { subscribe Settled as post; }
    fn post(n: Int) { }
}
`,
    code: `group billing  = { Billing };
group research = { Research };

// Authored once. Every world that adopts it proves it again,
// against its own graph.
constitution Core {
    tenant_iso: forbid reaches(billing, research);
    one_writer: count publishers(topic Settled) == 1;
}

main locus App {
    params {
        b: Billing = Billing { };
        r: Research = Research { };
        l: Ledger = Ledger { };
    }

    claims { adopt Core; }
}` },
  { title: 'prod.plan.json', code: `{
  "schema": "1.1", "name": "prod",
  "instances": [
    {"id": "oms-0", "artifact": "artifacts/oms.json"},
    {"id": "gw-0",  "artifact": "artifacts/gateway.json"}
  ],
  "routes": [
    {"id": "request", "transport": "unix",
     "publishers":  [{"instance": "oms-0", "topic": "t::Order"}],
     "subscribers": [{"instance": "gw-0",  "topic": "t::Order"}]}
  ]
}` },
];
---

<section class="unfold" aria-labelledby="unfold-heading">
  <div class="unfold-viz" aria-hidden="true">
    <canvas id="unfold-canvas"></canvas>
    <div class="unfold-vignette"></div>
  </div>

  <h2 id="unfold-heading" class="sr-only">
    The same structure at every scale, from a value to a fleet
  </h2>

  <div class="unfold-beats">
    <article class="beat">
      <div class="beat-copy">      <p class="eyebrow">value &amp; behavior</p>
      <h3>Start as deep as the structure goes.</h3>
      <p>
        A value, a function, a frontier the compiler can close around.
        Effect classes and budgets are proven here, across every path a
        call can reach.
      </p>
      </div>
      <div class="beat-viz">
        <Hale code={panels[0].code} title={panels[0].title} />
      </div>
    </article>

    <article class="beat">
      <div class="beat-copy">      <p class="eyebrow">ownership</p>
      <h3>Structure is the lifetime.</h3>
      <p>
        The cavity is a region: owned, bounded, and freed whole when the
        locus dissolves. No collector walks it and no annotation describes
        it. Dissolve the locus and the memory goes with it.
      </p>
      </div>
      <div class="beat-viz">
        <Hale code={panels[1].code} title={panels[1].title} />
      </div>
    </article>

    <article class="beat">
      <div class="beat-copy">      <p class="eyebrow">nesting</p>
      <h3>Children open inside their parent.</h3>
      <p>
        A child's region is a subregion of the one that owns it. That is
        why pulling back never shows you a different kind of thing. You
        were always inside one.
      </p>
      </div>
      <div class="beat-viz">
        <Hale code={panels[2].code} title={panels[2].title} />
      </div>
    </article>

    <article class="beat">
      <div class="beat-copy">      <p class="eyebrow">communication</p>
      <h3>Topics name the edge.</h3>
      <p>
        These loci do not reference one another; they communicate through
        a declared topic. A message rises to the topic, which sits
        structurally above them both, and comes back down into every
        subscriber. A call graph stops at a publish; the compiler keeps
        going.
      </p>
      </div>
      <div class="beat-viz">
        <Hale code={panels[3].code} title={panels[3].title} />
      </div>
    </article>

    <article class="beat">
      <div class="beat-copy">      <p class="eyebrow">execution</p>
      <h3>Placement is separate from logic.</h3>
      <p>
        The same locus can share a pool, own a thread, pin to a core, or
        sit across a process boundary. One block in <code>main</code>
        decides, and not one line of the loci changes.
      </p>
      </div>
      <div class="beat-viz">
        <Hale code={panels[4].code} title={panels[4].title} />
      </div>
    </article>

    <article class="beat">
      <div class="beat-copy">      <p class="eyebrow">failure</p>
      <h3>Recovery belongs to the owner.</h3>
      <p>
        Nothing fails sideways. Failure has exactly two channels, and both
        are declared: a value-level failure returns through
        {' '}<code>fallible(E)</code> and is addressed at the call site, and a
        structural failure travels up to the parent that owns it, with
        enough context to restart, quarantine, or let it keep rising.
      </p>
      </div>
      <div class="beat-viz">
        <Hale code={panels[5].code} title={panels[5].title} />
      </div>
    </article>

    <article class="beat">
      <div class="beat-copy">      <p class="eyebrow">application</p>
      <h3>One main locus closes a world.</h3>
      <p>
        Once the graph is exact it can carry law: named claims over the
        assembled system, checked as errors, answered with the path that
        broke them.
      </p>
      </div>
      <div class="beat-viz">
        <Hale code={panels[6].code} title={panels[6].title} />
      </div>
    </article>

    <article class="beat">
      <div class="beat-copy">      <p class="eyebrow">environment</p>
      <h3>The law outlives the program that states it.</h3>
      <p>
        A claimset can be authored once and adopted by every world that has
        to hold it. Each proves it independently, against its own graph.
        Composition is union only, so a rule can be added and never quietly
        weakened.
      </p>
      </div>
      <div class="beat-viz">
        <Hale code={panels[7].code} title={panels[7].title} />
      </div>
    </article>

    <article class="beat">
      <div class="beat-copy">      <p class="eyebrow">fleet</p>
      <h3>The recursion does not stop at the process.</h3>
      <p>
        A plan carries instances, routes, and claims, which is a main
        locus one scale out. Its certificate is signed over the artifact's
        exact bytes, so the fleet that runs is the fleet that was
        certified.
      </p>
      </div>
      <div class="beat-viz">
        <Hale code={panels[8].code} title={panels[8].title} />
      </div>
    </article>
  </div>
</section>

<style>
  /*
    The lotus field is the page's floor, not a panel inside it: the viz sits
    fixed behind every section at z-index -1 — above the body's background,
    below all content — so the whole document scrolls over one continuous
    field. The veil settles the edges so copy stays readable anywhere on it.
  */
  .unfold { position: relative; background: transparent; }
  .unfold-viz {
    position: fixed;
    inset: 0;
    height: 100vh;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }
  #unfold-canvas { display: block; width: 100%; height: 100%; }

  .unfold-vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    /* Heavier than the prototype's veil: the copy column lives on the left
       two-fifths of the page, so that side settles hardest. */
    background:
      radial-gradient(80% 70% at 64% 38%, transparent 0%, rgba(2,4,10,.14) 58%, rgba(2,4,10,.52) 100%),
      linear-gradient(90deg, rgba(2,4,10,.74) 0%, rgba(2,4,10,.44) 38%, rgba(2,4,10,.14) 67%, rgba(2,4,10,.38) 100%),
      linear-gradient(180deg, rgba(2,4,10,.60), rgba(2,4,10,.12) 20%, rgba(2,4,10,.12) 80%, rgba(2,4,10,.76) 100%);
  }

  .unfold-beats {
    position: relative;
    padding-inline: clamp(1.25rem, 6vw, 5rem);
    max-width: var(--maxw-wide);
    margin-inline: auto;
  }
  /*
    A beat is scroll distance for the camera as much as it is a paragraph,
    but a viewport each was too much of both: the text is ~200px centred in
    ~900px, so every pair of beats left ~700px — four fifths of a screen —
    with nothing written on it. Just over half a viewport keeps one beat
    dominant without the reader scrolling through a field to reach the next
    sentence, and it moves the camera further per turn of the wheel.
  */
  .beat {
    min-height: 52vh;
    display: grid;
    grid-template-columns: minmax(0, 27rem) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .beat-copy { display: flex; flex-direction: column; justify-content: center; }
  /* The panel is the one opaque thing over the field, so it needs an edge
     of its own or it reads as a hole punched in the animation. */
  .beat-viz :global(.code) {
    border-color: rgba(117, 232, 255, 0.18);
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.45), 0 0 40px rgba(90, 168, 255, 0.07);
  }
  .beat-viz :global(.code pre) { font-size: 0.8rem; }

  /* Below this the two columns stop being two columns: the panel goes
     under its paragraph rather than beside it, and the beat grows to fit
     instead of holding a height meant for a single column of prose. */
  @media (max-width: 950px) {
    .beat {
      grid-template-columns: minmax(0, 1fr);
      min-height: 0;
      padding-block: 2rem;
      gap: 1.5rem;
    }
  }
  /*
    Nothing moves the camera after the final beat, so the section should end
    where the argument does rather than on another half-screen of air with
    its own bottom padding laid under that.
  */
  .beat:last-child { min-height: 0; padding-bottom: 1.5rem; }
  .unfold { padding-bottom: 0; }

  .beat h3 {
    font-size: clamp(1.6rem, 3.1vw, 2.3rem);
    line-height: 1.14;
    letter-spacing: -0.025em;
    color: var(--lotus-text);
    margin: 0.35rem 0 0.9rem;
  }
  .beat p:not(.eyebrow) {
    margin: 0;
    color: var(--lotus-text-soft);
    font-size: 1.02rem;
    max-width: 34rem;
  }
  .beat code {
    background: rgba(117, 232, 255, 0.08);
    color: var(--jade-deep);
    padding: 0.1em 0.32em;
    border-radius: 4px;
  }

  .sr-only {
    position: absolute; width: 1px; height: 1px;
    padding: 0; margin: -1px; overflow: hidden;
    clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }

  /* The renderer paints one still frame under reduced motion; the beats
     become an ordinary run of prose over it, which is a fine thing to be. */
  @media (prefers-reduced-motion: reduce) {
    .beat { min-height: 0; padding-block: 2.2rem; }
  }
  @media (max-width: 700px) {
    .beat { max-width: none; }
    .unfold-vignette {
      background:
        radial-gradient(95% 70% at 50% 38%, transparent 0%, rgba(2,4,10,.16) 46%, rgba(2,4,10,.72) 100%),
        linear-gradient(180deg, rgba(2,4,10,.55), rgba(2,4,10,.10) 38%, rgba(2,4,10,.72));
    }
  }
</style>

<script>
  import { mountLotusField } from '../lib/lotus-field';
  import { clamp01, lerp } from '../lib/field';

  const cv = document.getElementById('unfold-canvas') as HTMLCanvasElement | null;

  /*
    The old scene moved a camera from one leaf out to a fleet. The
    lotus field keeps that gesture without owning the argument: scrolling pulls
    the camera back through the field, and message traffic picks up as more
    of the system comes on screen. The beats' code panels carry the
    semantics now; the field is the medium they float on.
  */
  if (cv) {
    const pageProgress = () => {
      const span = document.documentElement.scrollHeight - window.innerHeight;
      return span > 8 ? clamp01(window.scrollY / span) : 0;
    };
    // Quieter than the prototype's defaults: this field carries a page of
    // copy on top of it, so it earns its keep as ambience, not spectacle.
    mountLotusField(cv, {
      brightness: 0.85,
      density: 21,
      messageRate: 1.0,
      maxNodes: 30,
      camera: () => {
        const p = pageProgress();
        return { zoom: lerp(1.28, 0.8, p), activity: 0.9 + p * 0.5 };
      },
    });
  }
</script>
