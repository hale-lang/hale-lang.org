---
/*
  One domain, three altitudes: the job queue from the tutorial, shown
  as a program, then a service, then a deployed system. The claim the
  tabs make is continuity — each tab's "what didn't change" row is the
  point, not the new syntax.

  scripts/check-site.mjs extracts each `const NAME` rendered by <Hale>
  and prepends `const NAME_prelude` before running `hale check`, so
  every tab genuinely typechecks: the service tab's prelude carries the
  types and the loci the excerpt doesn't show, and the system tab's
  prelude carries the whole service. The snippets are the tutorial's
  own (docs/tutorial/job-queue), which keeps this section and the
  "build it yourself" link telling one story.
*/
import Hale from './Hale.astro';

const program = `type Job { id: Int; work: Int; }

fn process(j: Job) -> Int {
    return j.work * j.work;
}

fn main() {
    let j = Job { id: 1, work: 7 };
    println("job ", j.id, " -> ", process(j));
}`;

const service_prelude = `type Job    { id: Int; work: Int; }
type Result { id: Int; out: Int; }

fn process(j: Job) -> Int { return j.work * j.work; }

locus Reporter {
    bus { subscribe Results as on_result; }
    fn on_result(r: Result) { println("job ", r.id, " done -> ", r.out); }
}

locus Submitter {
    bus { publish Jobs; }
    birth() {
        Jobs <- Job { id: 1, work: 7 };
    }
}
`;
const service = `topic Jobs    { payload: Job; }
topic Results { payload: Result; }

locus Worker {
    bus {
        subscribe Jobs as on_job;
        publish   Results;
    }
    fn on_job(j: Job) {
        Results <- Result { id: j.id, out: process(j) };
    }
}

fn main() {
    Worker { };
    Reporter { };
    Submitter { };
}`;

const system_prelude = `type Job    { id: Int; work: Int; }
type Result { id: Int; out: Int; }

topic Jobs    { payload: Job; }
topic Results { payload: Result; }

fn process(j: Job) -> Int { return j.work * j.work; }

locus Worker {
    bus {
        subscribe Jobs as on_job;
        publish   Results;
    }
    fn on_job(j: Job) {
        Results <- Result { id: j.id, out: process(j) };
    }
}

locus Reporter {
    bus { subscribe Results as on_result; }
    fn on_result(r: Result) { println("job ", r.id, " done -> ", r.out); }
}
`;
const system = `main locus WorkerNode {
    params {
        worker:   Worker   = Worker { };
        reporter: Reporter = Reporter { };
    }
    placement {
        worker: cooperative(pool = jobs);
    }
    bindings {
        Jobs: unix("/run/jobs.sock", role: listen);
    }
}`;

const tabs = [
  {
    key: 'program',
    label: 'Program',
    code: program,
    file: 'jobs.hl',
    appeared: 'A type, a function, a main. The whole language a script needs.',
    unchanged: 'Nothing yet — this is the baseline the next two tabs preserve.',
  },
  {
    key: 'service',
    label: 'Service',
    code: service,
    file: 'service.hl',
    appeared:
      'Two topics and a worker locus: work arrives instead of being looped over, and the channel is typed.',
    unchanged: '`Job` and `process` — the first tab, line for line.',
  },
  {
    key: 'system',
    label: 'System',
    code: system,
    file: 'worker-node.hl',
    appeared:
      'Placement and a socket binding, in `main` only: the worker gets its own pool, and `Jobs` arrives over a Unix socket from another process.',
    unchanged:
      'Every locus and every topic from the service tab. Deployment changed; the program did not.',
  },
];
---
<div class="growth-switcher">
  <input type="radio" name="growth-tab" id="growth-program" checked />
  <input type="radio" name="growth-tab" id="growth-service" />
  <input type="radio" name="growth-tab" id="growth-system" />

  <div class="growth-tabs" role="tablist" aria-label="The same program at three altitudes">
    {tabs.map((t) => (
      <label for={`growth-${t.key}`} role="tab">{t.label}</label>
    ))}
  </div>

  <div class="growth-panels">
    {tabs.map((t) => (
      <section class={`growth-panel panel-${t.key}`}>
        <Hale code={t.code} title={t.file} />
        <dl>
          <div>
            <dt>what appeared</dt>
            <dd set:html={t.appeared.replace(/`([^`]+)`/g, '<code>$1</code>')} />
          </div>
          <div>
            <dt>what didn't change</dt>
            <dd set:html={t.unchanged.replace(/`([^`]+)`/g, '<code>$1</code>')} />
          </div>
        </dl>
      </section>
    ))}
  </div>
</div>

<style>
  .growth-switcher { position: relative; }
  .growth-switcher > input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }
  .growth-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: 1rem;
  }
  .growth-tabs label {
    padding: 0.48rem 0.9rem;
    border: 1px solid var(--border-2);
    border-radius: 999px;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.78rem;
    cursor: pointer;
    user-select: none;
  }
  .growth-tabs label:hover { border-color: var(--jade); color: var(--jade-deep); }
  .growth-panel {
    display: none;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: 1.5rem;
    align-items: start;
    padding: 0;
  }
  .growth-panel dl { margin: 0; border-block: 1px solid var(--border); }
  .growth-panel dl > div {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    gap: 0.8rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--border);
  }
  .growth-panel dl > div:last-child { border-bottom: 0; }
  .growth-panel dt {
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.76rem;
  }
  .growth-panel dd { margin: 0; color: var(--ink-soft); font-size: 0.93rem; }

  #growth-program:checked ~ .growth-tabs label[for="growth-program"],
  #growth-service:checked ~ .growth-tabs label[for="growth-service"],
  #growth-system:checked ~ .growth-tabs label[for="growth-system"] {
    border-color: var(--jade);
    background: var(--jade-tint);
    color: var(--jade-deep);
  }
  #growth-program:checked ~ .growth-panels .panel-program,
  #growth-service:checked ~ .growth-panels .panel-service,
  #growth-system:checked ~ .growth-panels .panel-system { display: grid; }

  @media (max-width: 760px) {
    .growth-panel,
    #growth-program:checked ~ .growth-panels .panel-program,
    #growth-service:checked ~ .growth-panels .panel-service,
    #growth-system:checked ~ .growth-panels .panel-system {
      grid-template-columns: minmax(0, 1fr);
    }
    .growth-panel dl > div { grid-template-columns: 7rem 1fr; }
  }
</style>
