---
/*
  The tutorial's job queue at three sizes: a program, a service, a
  deployed system. The claim is continuity, so each step marks what it
  added (a tick in the gutter) and what it carried over unchanged from the
  step before (a dotted underline), and the ledger beside it says both.

  scripts/check-site.mjs compiles each listing here: it finds every
  `const NAME` rendered by <Hale code={NAME} title="…"> and prepends
  `const NAME_prelude`. The service prelude carries the types and loci the
  excerpt does not show; the system prelude carries the whole service. The
  snippets are the tutorial's own (docs/tutorial/job-queue).
*/
import Hale from './Hale.astro';

const program = `type Job { id: Int; work: Int; }

fn process(j: Job) -> Int {
    return j.work * j.work;
}

fn main() {
    let j = Job { id: 1, work: 7 };
    println("job ", j.id, " -> ", process(j));
}`;

const service_prelude = `type Job    { id: Int; work: Int; }
type Result { id: Int; out: Int; }

fn process(j: Job) -> Int { return j.work * j.work; }

locus Reporter {
    bus { subscribe Results as on_result; }
    fn on_result(r: Result) { println("job ", r.id, " done -> ", r.out); }
}

locus Submitter {
    bus { publish Jobs; }
    birth() {
        Jobs <- Job { id: 1, work: 7 };
    }
}
`;

const service = `topic Jobs    { payload: Job; }
topic Results { payload: Result; }

locus Worker {
    bus {
        subscribe Jobs as on_job;
        publish   Results;
    }
    fn on_job(j: Job) {
        Results <- Result { id: j.id, out: process(j) };
    }
}

fn main() {
    Worker { };
    Reporter { };
    Submitter { };
}`;

const system_prelude = `type Job    { id: Int; work: Int; }
type Result { id: Int; out: Int; }

topic Jobs    { payload: Job; }
topic Results { payload: Result; }

fn process(j: Job) -> Int { return j.work * j.work; }

locus Worker {
    bus {
        subscribe Jobs as on_job;
        publish   Results;
    }
    fn on_job(j: Job) {
        Results <- Result { id: j.id, out: process(j) };
    }
}

locus Reporter {
    bus { subscribe Results as on_result; }
    fn on_result(r: Result) { println("job ", r.id, " done -> ", r.out); }
}
`;

const system = `main locus WorkerNode {
    params {
        worker:   Worker   = Worker { };
        reporter: Reporter = Reporter { };
    }
    placement {
        worker: cooperative(pool = jobs);
    }
    bindings {
        Jobs: unix("/run/jobs.sock", role: listen);
    }
}`;

const programMarks = { new: [1, 3, 7] };
const serviceMarks = { new: [1, 2, 4, 6, 7], kept: [[9, 'Job'], [10, 'process']] as [number, string][] };
const systemMarks = {
  new: [6, 7, 9, 10],
  kept: [[3, 'Worker'], [4, 'Reporter'], [10, 'Jobs']] as [number, string][],
};
---
<div class="alt">
  <input type="radio" name="alt" id="alt-program" checked />
  <input type="radio" name="alt" id="alt-service" />
  <input type="radio" name="alt" id="alt-system" />

  <div class="dial" role="radiogroup" aria-label="The same program at three sizes">
    <label for="alt-program"><span class="n">01</span><b>Program</b><small>jobs.hl</small></label>
    <label for="alt-service"><span class="n">02</span><b>Service</b><small>service.hl</small></label>
    <label for="alt-system"><span class="n">03</span><b>System</b><small>worker-node.hl</small></label>
  </div>
  <p class="legend"><span><span class="sw" aria-hidden="true"></span>added at this step</span><span><span class="kept">kept</span>&nbsp; unchanged from the step before</span></p>

  <div class="alt-panels">
    <section class="alt-panel panel-program" aria-label="Program">
      <Hale code={program} title="jobs.hl" kind="program" marks={programMarks} />
      <dl class="ledger">
        <div><dt>added</dt><dd>A type, a function and a main. That is everything a script needs.</dd></div>
        <div><dt>unchanged</dt><dd>Nothing yet. This is the baseline the next two steps keep.</dd></div>
      </dl>
    </section>

    <section class="alt-panel panel-service" aria-label="Service">
      <Hale code={service} title="service.hl" kind="service" marks={serviceMarks} />
      <dl class="ledger">
        <div><dt>added</dt><dd>Two topics and a Worker locus. Work arrives on a typed topic; nothing loops over it.</dd></div>
        <div><dt>unchanged</dt><dd><code>Job</code> and <code>process</code>, line for line.
          <ul class="carried" aria-label="Carried over unchanged"><li>type Job</li><li>fn process</li></ul></dd></div>
      </dl>
    </section>

    <section class="alt-panel panel-system" aria-label="System">
      <Hale code={system} title="worker-node.hl" kind="system" marks={systemMarks} />
      <dl class="ledger">
        <div><dt>added</dt><dd>A placement block and a socket binding, both in <code>main</code>. The worker gets its own pool, and <code>Jobs</code> arrives over a Unix socket from another process.</dd></div>
        <div><dt>unchanged</dt><dd>Every locus and every topic from the service. Only the deployment changed.
          <ul class="carried" aria-label="Carried over unchanged"><li>topic Jobs</li><li>topic Results</li><li>locus Worker</li><li>locus Reporter</li></ul></dd></div>
      </dl>
    </section>
  </div>
</div>
