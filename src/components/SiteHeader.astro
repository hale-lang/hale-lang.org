---
/*
  The one header. Rendered by Nav.astro on the marketing pages and by
  StarlightHeader.astro inside the docs, so both get the same brand, the
  same link row in the same order, the same source link, and the same
  theme control.

  The only permitted difference is the search box: Pagefind indexes the
  docs, so <slot name="search" /> is filled there and empty everywhere
  else. Anything else that differs between the two is a bug — see
  src/styles/nav.css.
*/
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import { navLinks } from '../nav-links';

interface Props { hasSearch?: boolean }
const { hasSearch = false } = Astro.props;

// Mark the current section so a reader can see where they are. The docs
// live under /docs/*, so match on prefix rather than equality.
const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
---
<div class="site-header">
  <a class="brand" href="/"><Logo /> hale</a>

  <nav class="nav-links" aria-label="Primary">
    {navLinks.map((l) => (
      <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a>
    ))}
  </nav>

  <div class="nav-end">
    {hasSearch && <div class="nav-search"><slot name="search" /></div>}
    <a class="nav-icon" href="https://github.com/hale-lang"
       target="_blank" rel="noopener" aria-label="Hale on GitHub">
      <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
        <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38
                 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13
                 -.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66
                 .07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15
                 -.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09
                 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15
                 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2
                 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
      </svg>
    </a>
    <ThemeToggle />
  </div>
</div>
