---
/*
  A three-state theme control (auto / light / dark), used in BOTH headers so
  the docs and the marketing pages offer the same affordance in the same
  place. It is deliberately not Starlight's <ThemeSelect />: that component
  only resolves inside Starlight's own render, so using it would have meant
  the docs having a toggle the rest of the site could not have.

  It reads and writes Starlight's storage key with Starlight's exact value
  semantics — 'light' | 'dark', and the empty string for auto — so the two
  controls are interchangeable and a choice made on either side of the
  /docs boundary survives crossing it.
*/
---
<theme-toggle class="theme-toggle">
  <label>
    {/* The accessible name lives on the <select> itself. An .sr-only span
        here would depend on a utility class that global.css defines and
        the docs' stylesheet does not, so it rendered as visible text on
        exactly half the site. */}
    <span class="icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
           stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4" />
      </svg>
    </span>
    <select aria-label="Colour theme">
      <option value="">Auto</option>
      <option value="light">Light</option>
      <option value="dark">Dark</option>
    </select>
  </label>
</theme-toggle>

<style>
  .theme-toggle label {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--nav-link);
    cursor: pointer;
  }
  .theme-toggle label:hover { color: var(--nav-link-hover); }
  .theme-toggle .icon { display: inline-flex; }
  .theme-toggle svg { width: 16px; height: 16px; }
  .theme-toggle select {
    appearance: none;
    background: transparent;
    border: 0;
    color: inherit;
    font: inherit;
    font-size: 0.88rem;
    padding: 0.15rem 0.1rem;
    cursor: pointer;
  }
  .theme-toggle select:focus-visible {
    outline: 2px solid var(--nav-accent);
    outline-offset: 2px;
    border-radius: 4px;
  }
  /* The dropdown itself is painted by the OS, which does not inherit the
     page's custom properties — give the options a readable pair. */
  .theme-toggle option { background: var(--nav-bg-solid); color: var(--nav-link-hover); }
  @media (max-width: 560px) {
    .theme-toggle select { display: none; }
  }
</style>

<script is:inline>
  /*
    Inline and pre-hydration on purpose: Base.astro already resolved the
    theme before first paint, and this only has to keep the control in
    sync with it and write changes back.
  */
  (() => {
    const KEY = 'starlight-theme';
    const parse = (t) => (t === 'light' || t === 'dark' ? t : '');
    const systemTheme = () =>
      matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';

    function apply(choice) {
      document.documentElement.dataset.theme = choice || systemTheme();
      try { localStorage.setItem(KEY, choice); } catch {}
    }

    class ThemeToggle extends HTMLElement {
      connectedCallback() {
        const select = this.querySelector('select');
        if (!select) return;
        let stored = '';
        try { stored = parse(localStorage.getItem(KEY)); } catch {}
        select.value = stored;
        select.addEventListener('change', (e) => apply(parse(e.currentTarget.value)));
      }
    }
    if (!customElements.get('theme-toggle')) {
      customElements.define('theme-toggle', ThemeToggle);
    }

    // Follow the system while the reader is on "auto".
    matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
      let stored = '';
      try { stored = parse(localStorage.getItem(KEY)); } catch {}
      if (!stored) document.documentElement.dataset.theme = systemTheme();
    });
  })();
</script>
