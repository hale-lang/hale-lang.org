---
/*
  Dark-first theme toggle. Stored under Starlight's own key ('starlight-theme')
  so a choice made on the site's pages holds in the docs and vice versa.
  Default when unset is 'dark' (Dark Technofuturism).
*/
---
<button class="iconbtn theme" type="button" data-theme-toggle aria-label="Switch colour theme" title="Theme: dark">dark</button>

<script>
  type Mode = 'dark' | 'light';
  const KEY = 'starlight-theme';

  const load = (): Mode => {
    try {
      return localStorage.getItem(KEY) === 'light' ? 'light' : 'dark';
    } catch {
      return 'dark';
    }
  };

  function apply(m: Mode) {
    document.documentElement.dataset.theme = m;
    try { localStorage.setItem(KEY, m); } catch { /* private window */ }
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((b) => {
      b.textContent = m;
      b.title = `Theme: ${m}`;
    });
  }

  apply(load());
  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((b) =>
    b.addEventListener('click', () => apply(load() === 'dark' ? 'light' : 'dark')),
  );
</script>
