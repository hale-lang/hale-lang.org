---
import Logo from './Logo.astro';
import { navLinks } from '../nav-links';
---
<nav class="nav">
  <div class="container wide nav-inner">
    <a class="brand" href="/"><Logo /> hale</a>
    <div class="links">
      {navLinks.map((l) => (
        <a href={l.href} class={l.sm ? 'hide-sm' : ''}>{l.label}</a>
      ))}
      <a class="cta" href="https://github.com/hale-lang">GitHub ↗</a>
    </div>
  </div>
</nav>
