---
/*
  Override of Starlight's Header so the docs and the marketing pages render
  the identical header component. Everything visible comes from
  SiteHeader.astro; this file exists only because Starlight's <Search />
  resolves from a virtual module that is available inside a Starlight
  override and nowhere else, so the search box has to be passed in from
  here as a slot.

  Note what is deliberately NOT here any more: Starlight's own SocialIcons
  and ThemeSelect. The shared header carries a source link and a theme
  toggle of its own, so the docs and the rest of the site offer the same
  controls in the same order rather than two different right-hand rails.
*/
import config from 'virtual:starlight/user-config';
import Search from 'virtual:starlight/components/Search';
import SiteHeader from './SiteHeader.astro';

const shouldRenderSearch =
  config.pagefind ||
  config.components.Search !== '@astrojs/starlight/components/Search.astro';
---
<SiteHeader hasSearch={shouldRenderSearch}>
  <Search slot="search" />
</SiteHeader>
